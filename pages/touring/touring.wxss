page {
  height: 100%;
  background: #d9ccb2;
}

.tour-page {
  position: relative;
  width: 100%;
  height: 100vh;
  color: #514839;
  background: #d9ccb2;
  overflow: hidden;
}

.page-swiper,
.page-slide {
  width: 100%;
  height: 100vh;
}

.snap-section,
.tour-screen {
  position: relative;
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
}

.tour-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  animation: bgBreath 12s ease-in-out infinite alternate;
}

.tour-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    linear-gradient(180deg, rgba(246, 239, 220, 0.4) 0%, rgba(216, 203, 174, 0.06) 42%, rgba(210, 193, 160, 0.58) 100%),
    radial-gradient(circle at 18% 15%, rgba(255, 248, 225, 0.5), rgba(255, 248, 225, 0) 32%),
    radial-gradient(circle at 92% 84%, rgba(108, 82, 48, 0.26), rgba(108, 82, 48, 0) 35%);
}

.tour-vignette {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  box-shadow: inset 0 0 120rpx rgba(62, 45, 25, 0.22);
}

.tour-header {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  padding: 78rpx 48rpx 0;
  animation: fadeDown 700ms ease-out both;
}

.header-mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(134, 104, 61, 0.34);
  background: radial-gradient(circle, rgba(141, 95, 48, 0.18) 0%, rgba(141, 95, 48, 0.12) 42%, rgba(255, 248, 227, 0.2) 44%, rgba(255, 248, 227, 0.2) 100%);
  box-shadow: 0 8rpx 22rpx rgba(91, 66, 36, 0.12);
}

.header-text {
  margin-left: 18rpx;
}

.header-title {
  color: rgba(83, 69, 48, 0.72);
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: 0;
}

.header-subtitle {
  margin-top: 4rpx;
  color: rgba(101, 85, 58, 0.5);
  font-size: 19rpx;
  line-height: 1.2;
  letter-spacing: 0;
}

.translate-float {
  position: absolute;
  top: 172rpx;
  right: 38rpx;
  z-index: 5;
  display: flex;
  align-items: center;
  max-width: 360rpx;
  min-height: 82rpx;
  padding: 14rpx 18rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(74, 57, 34, 0.14);
  border-radius: 8rpx;
  background: rgba(255, 250, 236, 0.78);
  box-shadow: 0 12rpx 26rpx rgba(78, 56, 30, 0.12);
  backdrop-filter: blur(8rpx);
  animation: fadeDown 700ms ease-out 120ms both;
}

.translate-icon {
  width: 54rpx;
  height: 54rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  color: #fff6df;
  font-size: 24rpx;
  line-height: 54rpx;
  text-align: center;
  font-weight: 900;
  background: #2f6860;
}

.translate-title {
  color: #3d3020;
  font-size: 25rpx;
  line-height: 1.15;
  font-weight: 900;
}

.translate-desc {
  margin-top: 6rpx;
  color: rgba(61, 48, 32, 0.56);
  font-size: 19rpx;
  line-height: 1.2;
  font-weight: 700;
}

.menu-zone {
  position: absolute;
  z-index: 3;
  left: 0;
  right: 0;
  bottom: 250rpx;
  animation: menuIn 800ms ease-out 220ms both;
}

.menu-swiper {
  width: 100%;
  height: 390rpx;
}

.menu-slide {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 390rpx;
  overflow: visible;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 300rpx;
  height: 360rpx;
  opacity: 0.72;
  transform: scale(0.82);
  transition: transform 260ms ease, opacity 260ms ease;
}

.menu-item--major {
  transform: scale(0.9);
  opacity: 0.86;
}

.menu-item--active {
  opacity: 1;
  transform: scale(1.08);
}

.menu-item--major.menu-item--active {
  transform: scale(1.16);
}

.menu-item:active {
  opacity: 0.86;
}

.menu-icon {
  width: 350rpx;
  height: 350rpx;
}

.menu-item--active .menu-icon {
  width: 380rpx;
  height: 380rpx;
}

.menu-item--major .menu-icon {
  width: 370rpx;
  height: 370rpx;
}

.menu-item--major.menu-item--active .menu-icon {
  width: 410rpx;
  height: 410rpx;
}

.menu-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 34rpx;
  margin-top: 0;
}

.menu-dot {
  width: 10rpx;
  height: 10rpx;
  margin: 0 7rpx;
  border-radius: 50%;
  background: rgba(105, 86, 59, 0.3);
}

.menu-dot--active {
  width: 16rpx;
  height: 16rpx;
  background: #1f1b16;
}

.more-cue {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 286rpx;
  height: 42rpx;
  margin: 0 auto;
  color: rgba(76, 58, 34, 0.46);
}

.map-screen {
  position: relative;
  z-index: 4;
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  background: #182329;
  overflow: hidden;
}

.map-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.78;
  transform: scale(1.02);
}

.map-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    linear-gradient(180deg, rgba(18, 25, 27, 0.26) 0%, rgba(18, 25, 27, 0.02) 36%, rgba(24, 24, 21, 0.46) 100%),
    radial-gradient(circle at 18% 12%, rgba(251, 222, 152, 0.18), rgba(251, 222, 152, 0) 28%),
    radial-gradient(circle at 76% 45%, rgba(61, 137, 130, 0.12), rgba(61, 137, 130, 0) 35%);
}

.museum-map {
  position: relative;
  z-index: 4;
  height: 100vh;
  min-height: 100vh;
  padding: 82rpx 0 286rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.map-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  text-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.38);
}

.map-title {
  margin: 0 22rpx;
  color: #fff0cf;
  font-size: 48rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 0;
}

.map-ornament {
  color: rgba(255, 221, 153, 0.62);
  font-size: 26rpx;
}

.map-center-visual {
  position: absolute;
  left: 0;
  right: 0;
  top: 300rpx;
  z-index: 5;
  height: 650rpx;
  background: transparent;
  overflow: hidden;
}

.map-center-slide {
  display: flex;
  align-items: center;
  justify-content: center;
}

.map-center-image {
  width: 100%;
  height: 100%;
}

.map-center-caption {
  position: absolute;
  left: 54rpx;
  right: 54rpx;
  top: 956rpx;
  z-index: 2;
  color: #fff4db;
  text-align: center;
  text-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.48);
}

.map-center-name {
  font-size: 42rpx;
  line-height: 1.1;
  font-weight: 800;
}

.map-center-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.34;
}

.city-tabs {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 418rpx;
  z-index: 6;
  height: 72rpx;
}

.map-cue {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 344rpx;
  z-index: 7;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 286rpx;
  height: 42rpx;
  margin: 0 auto;
  color: rgba(255, 238, 202, 0.58);
}

.city-tab-slide {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
}

.city-tab {
  min-width: 132rpx;
  height: 54rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 238, 190, 0.22);
  border-radius: 10rpx;
  color: rgba(255, 239, 205, 0.72);
  font-size: 25rpx;
  line-height: 50rpx;
  text-align: center;
  font-weight: 700;
  background: rgba(22, 27, 26, 0.36);
}

.city-tab--active {
  min-width: 156rpx;
  border-color: rgba(255, 232, 176, 0.78);
  background: #1f1b16;
  color: #fff0cf;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.25);
}

.map-after-screen {
  position: relative;
  width: 100%;
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
  background: #151b18;
}

.map-after-bg {
  width: 100%;
  height: 100%;
}

.ai-butler {
  position: absolute;
  right: 28rpx;
  bottom: 238rpx;
  z-index: 12;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  animation: butlerRise 700ms ease-out both, butlerFloat 3.6s ease-in-out 800ms infinite;
}

.butler-bubble {
  position: relative;
  max-width: 360rpx;
  min-height: 66rpx;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 238, 197, 0.56);
  border-radius: 8rpx;
  color: #fff3d7;
  font-size: 26rpx;
  line-height: 1.42;
  text-align: left;
  background: rgba(35, 30, 22, 0.66);
  box-shadow: 0 12rpx 38rpx rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(10rpx);
}

.butler-bubble::after {
  content: '';
  position: absolute;
  right: 44rpx;
  bottom: -13rpx;
  width: 22rpx;
  height: 22rpx;
  border-right: 1rpx solid rgba(255, 238, 197, 0.46);
  border-bottom: 1rpx solid rgba(255, 238, 197, 0.46);
  background: rgba(35, 30, 22, 0.66);
  transform: rotate(45deg);
}

.butler-avatar-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 176rpx;
  height: 176rpx;
  margin-top: 10rpx;
}

.butler-avatar-wrap::before {
  content: '';
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 10rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.22);
  filter: blur(10rpx);
}

.butler-avatar {
  position: relative;
  width: 176rpx;
  height: 176rpx;
}

.butler-dialog-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 98;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 28rpx 250rpx;
  box-sizing: border-box;
  background: rgba(17, 16, 13, 0.32);
}

.butler-dialog {
  width: 100%;
  max-height: 78vh;
  padding: 28rpx 24rpx 22rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 238, 201, 0.44);
  border-radius: 8rpx;
  background:
    linear-gradient(180deg, rgba(255, 248, 232, 0.96) 0%, rgba(244, 230, 203, 0.95) 100%),
    #f7ecd5;
  box-shadow: 0 -12rpx 44rpx rgba(28, 22, 14, 0.22);
  animation: dialogUp 260ms ease-out both;
}

.dialog-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
}

.dialog-title-wrap {
  min-width: 0;
}

.dialog-title {
  color: #2f2419;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 800;
}

.dialog-subtitle {
  margin-top: 8rpx;
  color: rgba(91, 67, 42, 0.68);
  font-size: 22rpx;
  line-height: 1.2;
}

.ai-status-panel {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(120, 82, 42, 0.16);
  border-radius: 8rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.64), rgba(244, 225, 190, 0.42)),
    rgba(255, 255, 255, 0.5);
}

.ai-live-status {
  display: flex;
  align-items: center;
  min-height: 46rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: rgba(47, 125, 79, 0.08);
}

.ai-live-pulse {
  width: 14rpx;
  height: 14rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #2f7d4f;
  box-shadow: 0 0 0 0 rgba(47, 125, 79, 0.4);
  animation: aiPulse 1.4s ease-out infinite;
}

.ai-live-text {
  flex: 1;
  min-width: 0;
  color: #2f5f3d;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 800;
}

.ai-status-item {
  display: flex;
  align-items: center;
}

.ai-status-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #2f7d4f;
  box-shadow: 0 0 16rpx rgba(47, 125, 79, 0.52);
}

.ai-status-label {
  color: #2f2419;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.ai-status-value {
  margin-top: 4rpx;
  color: rgba(79, 58, 35, 0.62);
  font-size: 20rpx;
  line-height: 1.2;
}

.dialog-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border: 1rpx solid rgba(94, 65, 34, 0.18);
  border-radius: 50%;
  color: rgba(59, 43, 25, 0.72);
  font-size: 42rpx;
  line-height: 1;
  background: rgba(255, 255, 255, 0.46);
}

.chat-list {
  height: 460rpx;
  padding: 8rpx 4rpx;
  box-sizing: border-box;
}

.chat-row {
  display: flex;
  width: 100%;
  margin-bottom: 18rpx;
}

.chat-row--assistant {
  justify-content: flex-start;
}

.chat-row--user {
  justify-content: flex-end;
}

.chat-message {
  max-width: 600rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 1.55;
  white-space: pre-wrap;
}

.chat-message--assistant {
  color: #3d2e20;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 8rpx 24rpx rgba(75, 53, 28, 0.08);
}

.chat-message--user {
  color: #fff5dc;
  background: linear-gradient(135deg, #80542c 0%, #b87837 100%);
  box-shadow: 0 8rpx 22rpx rgba(120, 76, 34, 0.2);
}

.chat-message--thinking {
  color: rgba(73, 52, 29, 0.62);
  animation: thinkingPulse 1.1s ease-in-out infinite;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 8rpx;
}

.quick-question {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(120, 82, 42, 0.22);
  border-radius: 8rpx;
  color: #6b4726;
  font-size: 22rpx;
  line-height: 1.25;
  text-align: center;
  background: rgba(255, 251, 240, 0.64);
}

.quick-question:active {
  background: rgba(232, 204, 160, 0.58);
}

.chat-input-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 10rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(112, 81, 46, 0.18);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.7);
}

.chat-input {
  flex: 1;
  height: 58rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  color: #33261b;
  font-size: 25rpx;
  line-height: 58rpx;
}

.send-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 58rpx;
  border-radius: 8rpx;
  color: #fff8e8;
  font-size: 24rpx;
  font-weight: 700;
  background: #2f2419;
}

.cue-arrow {
  height: 28rpx;
  font-size: 32rpx;
  line-height: 26rpx;
  animation: cueFloat 1.6s ease-in-out infinite;
}

.cue-text {
  margin-top: 0;
  margin-left: 8rpx;
  font-size: 22rpx;
  line-height: 1.1;
  letter-spacing: 0;
  font-weight: 500;
}

@keyframes bgBreath {
  from {
    transform: scale(1.02);
  }

  to {
    transform: scale(1.07) translateY(-16rpx);
  }
}

@keyframes fadeDown {
  from {
    opacity: 0;
    transform: translateY(-24rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes menuIn {
  from {
    opacity: 0;
    transform: translateY(46rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes cueFloat {
  0%,
  100% {
    transform: translateY(0);
    opacity: 0.58;
  }

  50% {
    transform: translateY(-8rpx);
    opacity: 0.95;
  }
}

@keyframes butlerRise {
  from {
    opacity: 0;
    transform: translateY(24rpx) scale(0.94);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes butlerFloat {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-10rpx);
  }
}

@keyframes dialogUp {
  from {
    opacity: 0;
    transform: translateY(42rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes thinkingPulse {
  0%,
  100% {
    opacity: 0.54;
  }

  50% {
    opacity: 1;
  }
}

@keyframes aiPulse {
  0% {
    box-shadow: 0 0 0 0 rgba(47, 125, 79, 0.42);
  }

  100% {
    box-shadow: 0 0 0 18rpx rgba(47, 125, 79, 0);
  }
}
