/* pages/orders/orders.wxss */
.cart-container {
  padding: 10px;
  background-color: #f4f4ec;
  height:1200px;
}

.cart-item {
  position: relative;
  margin-bottom: 10px;
  background-color: rgb(255, 246, 168);
  overflow: hidden;
  display: flex;
  transition: transform 0.3s ease;
}

.item-content {
  display: flex;
  align-items: center;
  width: 100%;
  transition: transform 0.3s ease;
}

.item-photo image {
  width: 80px;
  height: 80px;
  object-fit: cover;
  margin-right: 10px;
}

.item-info {
  flex-grow: 1;
}

.item-name {
  font-size: 16px;
  margin-bottom: 5px;
}

.item-quantity {
  font-size: 14px;
  color: #888;
}

.item-price {
  font-size: 16px;
  color: #f60;
  margin-right: 10px;
}

.item-select checkbox {
  width: 20px;
  height: 20px;
}

.swipe-buttons {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  width: 150px;
  transform: translateX(150px); /* 使按钮初始时在视图外 */
  transition: transform 0.3s ease;
}

.share-btn, .delete-btn {
  width: 75px;
  height: 100%;
  color: rgb(247, 27, 27);
  font-size: 14px;
}

.share-btn {
  background-color: blue;
}

.delete-btn {
  background-color: red;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: space-between;
  padding: 10px;
  background-color: #fff;
  border-top: 1px solid #f0f0f0;
}

.select-all-btn, .pay-btn {
  padding: 10px 20px;
  cursor: pointer;
}

.select-all-btn {
  background-color: #f60;
  color: white;
}

.pay-btn {
  background-color: #f60;
  color: white;
}
