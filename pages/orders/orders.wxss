page {
  background: #f4f0e6;
}

.orders-page {
  height: 100vh;
  padding: 34rpx 28rpx 70rpx;
  box-sizing: border-box;
  color: #33271c;
}

.orders-hero {
  padding: 30rpx 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #34271c, #8f653c);
  color: #fff7e8;
  box-shadow: 0 16rpx 36rpx rgba(74, 52, 30, 0.18);
}

.orders-title {
  font-size: 44rpx;
  line-height: 1.15;
  font-weight: 900;
}

.orders-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 247, 232, 0.72);
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 700;
}

.tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.tab-item {
  padding: 18rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.76);
  text-align: center;
  box-shadow: 0 10rpx 22rpx rgba(74, 52, 30, 0.07);
}

.tab-item.active {
  background: #2f2419;
  color: #fff7e8;
}

.tab-title {
  font-size: 24rpx;
  font-weight: 900;
}

.tab-count {
  margin-top: 8rpx;
  color: rgba(83, 62, 38, 0.56);
  font-size: 22rpx;
  font-weight: 900;
}

.tab-item.active .tab-count {
  color: rgba(255, 247, 232, 0.7);
}

.empty-order {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 610rpx;
  text-align: center;
}

.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  color: #fff8e7;
  font-size: 36rpx;
  font-weight: 900;
  background: #8a5b34;
  box-shadow: 0 14rpx 32rpx rgba(138, 91, 52, 0.22);
}

.empty-title {
  margin-top: 26rpx;
  color: #3a2b1f;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-desc {
  width: 520rpx;
  margin-top: 12rpx;
  color: rgba(79, 60, 40, 0.62);
  font-size: 25rpx;
  line-height: 1.48;
}

.market-button {
  width: 250rpx;
  height: 78rpx;
  margin-top: 32rpx;
  border-radius: 8rpx;
  color: #fff8e9;
  font-size: 26rpx;
  line-height: 78rpx;
  font-weight: 900;
  background: #2f2419;
}

.order-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 12rpx 28rpx rgba(74, 52, 30, 0.08);
}

.order-head,
.order-product,
.order-bottom,
.order-actions {
  display: flex;
  align-items: center;
}

.order-head,
.order-bottom,
.order-actions {
  justify-content: space-between;
}

.order-id {
  color: #35281c;
  font-size: 27rpx;
  font-weight: 900;
}

.order-time {
  margin-top: 7rpx;
  color: rgba(83, 62, 38, 0.56);
  font-size: 22rpx;
}

.order-status {
  color: #a65c22;
  font-size: 25rpx;
  font-weight: 900;
}

.order-product {
  margin-top: 22rpx;
}

.order-image {
  width: 116rpx;
  height: 116rpx;
  border-radius: 8rpx;
  background: #ead8bf;
}

.order-info {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.order-name {
  color: #35281c;
  font-size: 27rpx;
  line-height: 1.25;
  font-weight: 800;
}

.order-meta {
  margin-top: 8rpx;
  color: rgba(83, 62, 38, 0.6);
  font-size: 22rpx;
}

.order-price,
.order-total {
  color: #a65c22;
  font-size: 28rpx;
  font-weight: 900;
}

.order-bottom {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(95, 70, 42, 0.12);
  color: rgba(69, 50, 31, 0.68);
  font-size: 24rpx;
}

.order-actions {
  gap: 18rpx;
  margin-top: 22rpx;
}

.plain-action,
.main-action {
  flex: 1;
  height: 64rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 64rpx;
  font-weight: 900;
}

.plain-action {
  background: #f1e6d2;
  color: #7a5735;
}

.main-action {
  background: #2f2419;
  color: #fff7e8;
}

.bottom-space {
  height: 42rpx;
}
