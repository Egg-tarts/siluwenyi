<view class="page">
  <!-- 用户信息及标题 -->
  <view class="header">
    <image class="user-avatar" src="{{user.avatarUrl}}" />
    <view class="user-details">
      <text class="user-name">{{user.name}}</text>
      <text class="page-title">我的喜欢</text>
    </view>
  </view>

  <!-- 下拉刷新 -->
  <scroll-view
    class="content-container"
    scroll-y
    bindscrolltolower="loadMore"
    enable-back-to-top
    refresher-enabled
    refresher-triggered="onRefresh"
    refresher-background="#f4f4ec"
    refresher-text="下拉刷新"
  >
    <!-- 加载动画 -->
    <view wx:if="{{loading}}" class="loading-spinner">
      <image src="/assets/loading.gif" />
    </view>

    <!-- 喜欢的内容列表 -->
    <block wx:if="{{hasContent}}">
      <view class="favorites-container">
        <block wx:for="{{favorites}}" wx:key="index">
          <view class="favorite-item {{index % 2 === 0 ? 'left' : 'right'}}" bindtap="viewItem" data-item-id="{{item.id}}">
            <view class="favorite-header">{{item.title}}</view>
            <view class="favorite-body">{{item.description}}</view>
            <view class="favorite-footer">
              <text class="favorite-likes">点赞量：{{item.likes}}</text>
            </view>
          </view>
        </block>
      </view>
    </block>

    <!-- 无内容时显示 -->
    <block wx:else>
      <view class="no-content">
        <text>暂无喜欢的内容</text>
        <button class="explore-btn" bindtap="exploreMore">探索更多内容</button>
      </view>
    </block>

    <!-- 分页加载 -->
    <view wx:if="{{hasMore}}" class="load-more" bindtap="loadMore">
      <text>加载更多...</text>
    </view>
    <view wx:else class="no-more">
      <text>没有更多内容了</text>
    </view>
  </scroll-view>
</view>
