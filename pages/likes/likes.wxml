<scroll-view class="likes-page" scroll-y="true" enhanced="true" show-scrollbar="false">
  <view class="hero">
    <view class="hero-title">我的收藏</view>
    <view class="hero-subtitle">收藏的攻略、景点和社区故事会在这里沉淀。</view>
  </view>

  <view class="saved-list">
    <view wx:for="{{savedItems}}" wx:key="id" class="saved-card" data-title="{{item.title}}" bindtap="openItem">
      <image class="saved-image" src="{{item.image}}" mode="aspectFill" />
      <view class="saved-info">
        <view class="saved-tag">{{item.tag}}</view>
        <view class="saved-title">{{item.title}}</view>
        <view class="saved-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>
</scroll-view>
