page {
  background: #f4efe4;
}

.likes-page {
  min-height: 100vh;
  height: 100vh;
  box-sizing: border-box;
  padding: 78rpx 30rpx 50rpx;
  color: #33281d;
  background: linear-gradient(180deg, #f7f1e4, #efe3cf);
}

.hero {
  padding: 36rpx 30rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #536957, #b98a4e);
  color: #fff7e8;
  box-shadow: 0 14rpx 32rpx rgba(82, 66, 41, 0.16);
}

.hero-title {
  font-size: 48rpx;
  font-weight: 900;
}

.hero-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 247, 232, 0.78);
  font-size: 25rpx;
  line-height: 1.45;
}

.saved-list {
  margin-top: 24rpx;
}

.saved-card {
  display: flex;
  margin-bottom: 20rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: rgba(255, 252, 244, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(82, 66, 41, 0.1);
}

.saved-image {
  width: 190rpx;
  height: 180rpx;
  border-radius: 8rpx;
}

.saved-info {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
}

.saved-tag {
  display: inline-flex;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #efe0c4;
  color: #856239;
  font-size: 20rpx;
  font-weight: 900;
}

.saved-title {
  margin-top: 12rpx;
  color: #33281d;
  font-size: 31rpx;
  font-weight: 900;
}

.saved-desc {
  margin-top: 10rpx;
  color: rgba(51, 40, 29, 0.64);
  font-size: 24rpx;
  line-height: 1.44;
}
