<view class="page">
  <view class="header">
    <image class="user-avatar" src="{{user.avatarUrl}}" />
    <view class="user-details">
      <text class="user-name">{{user.name}}</text>
      <text class="page-title">历史浏览</text>
    </view>
  </view>

  <scroll-view
    class="content-container"
    scroll-y
    bindscrolltolower="loadMore"
    enable-back-to-top
    refresher-enabled
    refresher-triggered="onRefresh"
    refresher-background="#f4f4ec"
    refresher-text="下拉刷新"
  >
    <view wx:if="{{loading}}" class="loading-spinner">
      <image src="/assets/loading.gif" />
    </view>

    <block wx:if="{{hasContent}}">
      <view class="history-container">
        <block wx:for="{{historyItems}}" wx:key="index">
          <view class="history-item" bindtap="viewHistoryItem" data-item-id="{{item.id}}">
            <view class="history-header">{{item.title}}</view>
            <view class="history-body">{{item.description}}</view>
            <view class="history-footer">
              <text class="history-likes">点赞量：{{item.likes}}</text>
            </view>
          </view>
        </block>
      </view>
    </block>

    <block wx:else>
      <view class="no-content">
        <text>暂无历史行程</text>
        <button class="explore-btn" bindtap="exploreMore">查看更多历史行程</button>
      </view>
    </block>

    <view wx:if="{{hasMore}}" class="load-more" bindtap="loadMore">
      <text>加载更多...</text>
    </view>
    <view wx:else class="no-more">
      <text>没有更多历史信息了</text>
    </view>
  </scroll-view>
</view>
