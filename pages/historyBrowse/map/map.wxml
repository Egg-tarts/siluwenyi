<view class="" hover-class="none" hover-stop-propagation="false" style="width: 100%; height: 100%;">
  <map 
    id="map" 
    longitude="{{longitude}}" 
    latitude="{{latitude}}" 
    markers="{{markers}}" 
    polylines="{{polylines}}" 
    scale="14" 
    show-location 
    style="width: 100%; height: 100%;" 
    bindregionchange="bindregionchange" 
    bindtap="bindtapMap">
  </map>

  <!-- 添加确认行程按钮 -->
  <button 
    bindtap="confirmRoute" 
    style="position: fixed; bottom: 20px; width: 90%; left: 5%; background-color: #f3ac4e; color: #fff; height: 50px; border-radius: 5px;">
    确认行程
  </button>
</view>
