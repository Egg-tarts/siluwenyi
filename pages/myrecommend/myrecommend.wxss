page {
  background: #f4ead7;
}

.publish-page {
  min-height: 100vh;
  height: 100vh;
  box-sizing: border-box;
  padding: 70rpx 28rpx 0;
  color: #33281d;
  background:
    linear-gradient(180deg, rgba(251, 244, 231, 0.96), rgba(235, 215, 181, 0.94)),
    url("https://free.picui.cn/free/2026/06/21/6a377a096c7f3.png");
  background-size: cover;
  background-position: center top;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 70rpx;
}

.back-button,
.publish-action {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #6c5437;
  font-size: 24rpx;
  line-height: 56rpx;
  font-weight: 900;
  background: rgba(255, 252, 244, 0.78);
}

.publish-action {
  color: #fff7e8;
  background: #7c5a35;
}

.top-title {
  color: #33281d;
  font-size: 34rpx;
  font-weight: 900;
}

.author-card,
.editor-card,
.image-panel,
.publish-tips {
  margin-top: 24rpx;
  padding: 26rpx;
  border-radius: 8rpx;
  background: rgba(255, 252, 244, 0.9);
  box-shadow: 0 12rpx 28rpx rgba(91, 64, 31, 0.1);
}

.author-card {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #eadcc2;
}

.author-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.author-name {
  color: #33281d;
  font-size: 30rpx;
  font-weight: 900;
}

.author-desc {
  margin-top: 8rpx;
  color: rgba(51, 40, 29, 0.56);
  font-size: 23rpx;
  font-weight: 800;
}

.title-input {
  height: 78rpx;
  color: #33281d;
  font-size: 34rpx;
  line-height: 78rpx;
  font-weight: 900;
}

.content-input {
  width: 100%;
  height: 320rpx;
  margin-top: 14rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: rgba(51, 40, 29, 0.78);
  font-size: 27rpx;
  line-height: 1.56;
  background: rgba(239, 224, 196, 0.5);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag-chip {
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #7c5a35;
  font-size: 22rpx;
  line-height: 52rpx;
  font-weight: 900;
  background: rgba(239, 224, 196, 0.68);
}

.tag-chip--active {
  color: #fff7e8;
  background: #7c5a35;
}

.panel-title,
.tip-title {
  color: #33281d;
  font-size: 28rpx;
  font-weight: 900;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}

.image-cell,
.add-image {
  position: relative;
  width: 190rpx;
  height: 190rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: rgba(239, 224, 196, 0.62);
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.remove-image {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: #fff7e8;
  font-size: 34rpx;
  line-height: 38rpx;
  text-align: center;
  background: rgba(37, 28, 18, 0.55);
}

.add-image {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(124, 90, 53, 0.32);
}

.add-plus {
  color: #7c5a35;
  font-size: 52rpx;
  line-height: 1;
  font-weight: 300;
}

.add-text {
  margin-top: 10rpx;
  color: rgba(51, 40, 29, 0.58);
  font-size: 22rpx;
  font-weight: 900;
}

.tip-text {
  margin-top: 12rpx;
  color: rgba(51, 40, 29, 0.62);
  font-size: 24rpx;
  line-height: 1.48;
  font-weight: 800;
}

.bottom-space {
  height: 70rpx;
}
