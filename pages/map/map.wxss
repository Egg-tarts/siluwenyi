page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.map-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #f4ead7;
}

.route-map {
  width: 100%;
  height: 100vh;
}

.map-top {
  position: fixed;
  top: 34rpx;
  left: 32rpx;
  right: 32rpx;
  z-index: 5;
  padding: 22rpx 28rpx;
  border-radius: 18rpx;
  background: rgba(255, 248, 235, 0.92);
  box-shadow: 0 14rpx 40rpx rgba(72, 42, 18, 0.14);
}

.map-title {
  color: #4b2a16;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
}

.map-status {
  margin-top: 8rpx;
  color: rgba(75, 42, 22, 0.68);
  font-size: 24rpx;
  line-height: 1.4;
}

.confirm-button {
  position: fixed;
  right: 32rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  left: 32rpx;
  z-index: 5;
  height: 92rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #d65b2f, #e6a23a);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 92rpx;
  box-shadow: 0 18rpx 36rpx rgba(165, 82, 29, 0.28);
}

.confirm-button::after {
  border: 0;
}
