<view class="map-page">
  <map
    id="map"
    class="route-map"
    longitude="{{longitude}}"
    latitude="{{latitude}}"
    markers="{{markers}}"
    polyline="{{polylines}}"
    scale="{{scale}}"
    show-location
  ></map>

  <view class="map-top">
    <view class="map-title">丝路路线图</view>
    <view class="map-status">{{routeStatus}}</view>
  </view>

  <button class="confirm-button" bindtap="confirmRoute">确认行程</button>
</view>
