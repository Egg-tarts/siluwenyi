<scroll-view class="city-page" scroll-y="true" enhanced="true" show-scrollbar="false">
  <view class="hero">
    <image class="hero-image" src="{{city.image}}" mode="aspectFill" />
    <view class="hero-mask"></view>
    <view class="topbar">
      <view class="back-button" bindtap="goBack">‹ 返回</view>
      <view class="top-title">城市文博档案</view>
    </view>
    <view class="hero-content">
      <view class="city-en">{{city.en}}</view>
      <view class="city-name">{{city.name}}</view>
      <view class="city-slogan">{{city.slogan}}</view>
      <view class="tag-row">
        <view wx:for="{{city.tags}}" wx:key="*this" class="tag-chip">{{item}}</view>
      </view>
    </view>
  </view>

  <view class="intro-card">
    <view class="section-kicker">City Story</view>
    <view class="section-title">城市印象</view>
    <view class="intro-text">{{city.desc}}</view>
  </view>

  <view class="action-row">
    <view class="action-button" bindtap="openRoutePlanner">生成路线</view>
    <view class="action-button action-button--dark" bindtap="openImageMaker">影像生成</view>
  </view>

  <view class="section-card">
    <view class="section-title">文博看点</view>
    <view class="museum-list">
      <view wx:for="{{city.museums}}" wx:key="*this" wx:for-index="index" class="museum-item">
        <view class="museum-index">{{index + 1}}</view>
        <view class="museum-name">{{item}}</view>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">推荐顺序</view>
    <view class="route-line">
      <view wx:for="{{city.route}}" wx:key="*this" wx:for-index="index" class="route-item">
        <view class="route-dot"></view>
        <view class="route-main">
          <view class="route-step">第 {{index + 1}} 站</view>
          <view class="route-text">{{item}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="food-card">
    <view>
      <view class="section-kicker">Local Taste</view>
      <view class="section-title">陇上寻味</view>
    </view>
    <view class="food-list">
      <view wx:for="{{city.food}}" wx:key="*this" class="food-chip">{{item}}</view>
    </view>
  </view>

  <view class="tips-card">
    <view class="tips-title">出行提醒</view>
    <view class="tips-text">{{city.tips}}</view>
  </view>

  <view class="city-switch-title">切换城市</view>
  <scroll-view class="city-switch" scroll-x="true" show-scrollbar="false">
    <view class="city-switch-track">
      <view
        wx:for="{{cities}}"
        wx:key="name"
        wx:for-index="index"
        class="city-chip {{index === activeIndex ? 'city-chip--active' : ''}}"
        data-index="{{index}}"
        bindtap="chooseCity"
      >
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <view class="bottom-space"></view>
</scroll-view>
