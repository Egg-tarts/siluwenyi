<view class="page">
  <view class="header">
    <image class="user-avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
    <view class="user-details">
      <text class="user-name">{{user.name}}</text>
      <text class="page-title">我的评论</text>
    </view>
  </view>

  <scroll-view
    class="content-container"
    scroll-y
    bindscrolltolower="loadMore"
    enable-back-to-top
    refresher-enabled
    refresher-triggered="{{loading}}"
    bindrefresherrefresh="onRefresh"
    refresher-background="#f4f4ec"
    refresher-text="下拉刷新"
  >
    <view wx:if="{{loading}}" class="loading-spinner">
      <text>加载中...</text>
    </view>

    <block wx:if="{{hasContent}}">
      <view class="posts-container">
        <block wx:for="{{posts}}" wx:key="from_id">
          <view class="post-item" bindtap="viewPost" data-post-id="{{item.from_id}}">
            <view class="post-header">{{item.from_title}}</view>
            <view class="post-content">我的评论：{{item.comment_detail}}</view>
            <view class="post-content">时间：{{item.time}}</view>
          </view>
        </block>
      </view>
    </block>

    <block wx:else>
      <view class="no-content">
        <text>暂无评论内容，快去社区看看吧</text>
        <button class="create-btn" bindtap="createPost">前往评论</button>
      </view>
    </block>

    <view wx:if="{{hasMore}}" class="load-more" bindtap="loadMore">
      <text>加载更多...</text>
    </view>
    <view wx:else class="no-more">
      <text>已经到底了哦</text>
    </view>
  </scroll-view>
</view>
