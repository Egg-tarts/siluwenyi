/* 页面容器 */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background-color: #F4F4EC; /* 设置整体背景色 */
  min-height: 50vh; /* 使背景色覆盖整个页面高度 */
}

/* 表单区域 */
.form-section {
  width: 100%;
  max-width: 400px; /* 调整表单最大宽度 */
  background-color: #ffffff; /* 设置白框背景色 */
  padding: 20px;
  border-radius: 15px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  margin-bottom: 30px; /* 增加底部间距 */
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
}

/* 表单标签 */
.form-label {
  font-size: 18px;
  font-weight: bold;
  color: #333333;
  margin-right: 15px;
  width: 80px;
}

/* 头像 */
.avatar {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  border: 2px solid #dddddd;
}

/* 输入框 */
.input-field {
  flex: 1;
  padding: 10px;
  border: 1px solid #dddddd;
  border-radius: 10px;
  font-size: 16px;
  color: #333333;
  background-color: #f9f9f9;
}

/* 输入框的焦点状态 */
.input-field:focus {
  border-color: #007aff;
  background-color: #ffffff;
}

/* 提交按钮 */
.submit-button {
  width: 100%;
  padding: 15px;
  background-color: #e7d586;
  color: #ffffff;
  border: none;
  border-radius: 10px;
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  position: fixed;
  bottom: 20px; /* 固定在页面底部 */
  left: 50%;
  transform: translateX(-50%);
}

/* 提交按钮的按下状态 */
.submit-button:active {
  background-color: #b89421;
}

