page {
  background: #e8e2d4;
}

.page {
  min-height: 100vh;
  height: 100vh;
  padding: 76rpx 30rpx 58rpx;
  box-sizing: border-box;
  color: #243832;
  background:
    linear-gradient(180deg, rgba(246, 242, 232, 0.9), rgba(214, 226, 214, 0.94)),
    url("https://free.picui.cn/free/2026/06/21/6a376637d8919.png");
  background-size: cover;
  background-position: center top;
}

.back-button {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  padding: 0 22rpx;
  margin-bottom: 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 252, 244, 0.88);
  color: #4e6651;
  font-size: 25rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 18rpx rgba(49, 71, 50, 0.1);
}

.hero {
  padding: 38rpx 34rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, rgba(37, 65, 54, 0.96), rgba(74, 115, 79, 0.86));
  box-shadow: 0 18rpx 40rpx rgba(49, 71, 50, 0.18);
}

.eyebrow {
  color: rgba(235, 255, 226, 0.82);
  font-size: 22rpx;
  font-weight: 800;
}

.title {
  margin-top: 12rpx;
  color: #f2ffe9;
  font-size: 62rpx;
  line-height: 1.04;
  font-weight: 900;
}

.subtitle {
  margin-top: 16rpx;
  color: rgba(242, 255, 233, 0.82);
  font-size: 27rpx;
  line-height: 1.55;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.time-pill,
.refresh-pill {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(244, 255, 234, 0.14);
  color: #efffe8;
  font-size: 22rpx;
  font-weight: 800;
}

.refresh-pill {
  background: #efffe8;
  color: #304c3e;
}

.safety-panel {
  display: flex;
  align-items: stretch;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: rgba(255, 252, 244, 0.92);
  box-shadow: 0 14rpx 30rpx rgba(49, 71, 50, 0.16);
}

.score-box {
  flex: 0 0 168rpx;
  border-radius: 8rpx;
  color: #fff;
  text-align: center;
  padding: 28rpx 8rpx;
}

.score-safe {
  background: linear-gradient(180deg, #2f704c, #1f4e38);
}

.score-good {
  background: linear-gradient(180deg, #587b4c, #315745);
}

.score-warn {
  background: linear-gradient(180deg, #b36c31, #754723);
}

.score {
  font-size: 76rpx;
  line-height: 1;
  font-weight: 900;
}

.score-label {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  font-weight: 800;
}

.panel-main {
  flex: 1;
  min-width: 0;
  padding-left: 22rpx;
}

.panel-title,
.section-title {
  color: #243832;
  font-size: 34rpx;
  font-weight: 900;
}

.panel-desc,
.section-subtitle {
  margin-top: 8rpx;
  color: rgba(36, 56, 50, 0.66);
  font-size: 24rpx;
  line-height: 1.45;
}

.location-card {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #edf4ec;
}

.location-name {
  font-size: 28rpx;
  font-weight: 900;
}

.location-desc {
  margin-top: 6rpx;
  color: rgba(36, 56, 50, 0.62);
  font-size: 21rpx;
  line-height: 1.35;
}

.location-status {
  flex: 0 0 auto;
  height: 42rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #dcebdd;
  color: #315745;
  font-size: 20rpx;
  line-height: 42rpx;
  font-weight: 900;
}

.signal-grid,
.contact-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.signal-card,
.contact-card {
  padding: 20rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 252, 244, 0.9);
  text-align: center;
  box-shadow: 0 8rpx 18rpx rgba(49, 71, 50, 0.08);
}

.signal-label,
.contact-tip {
  color: rgba(36, 56, 50, 0.58);
  font-size: 20rpx;
  font-weight: 800;
}

.signal-value {
  margin-top: 8rpx;
  color: #243832;
  font-size: 30rpx;
  font-weight: 900;
}

.signal-state {
  margin-top: 6rpx;
  color: #526b55;
  font-size: 20rpx;
  font-weight: 800;
}

.section-head {
  margin-top: 30rpx;
}

.check-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: rgba(255, 252, 244, 0.9);
  box-shadow: 0 10rpx 24rpx rgba(49, 71, 50, 0.08);
}

.check-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #dcebdd;
  color: #fff;
  font-size: 28rpx;
  line-height: 48rpx;
  text-align: center;
  font-weight: 900;
}

.check-card .check-dot {
  box-sizing: border-box;
}

.check-card.done .check-dot {
  background: #526b55;
}

.check-main {
  flex: 1;
  min-width: 0;
}

.check-title {
  color: #243832;
  font-size: 29rpx;
  font-weight: 900;
}

.check-desc {
  margin-top: 7rpx;
  color: rgba(36, 56, 50, 0.64);
  font-size: 23rpx;
  line-height: 1.4;
}

.check-status {
  flex: 0 0 auto;
  color: #526b55;
  font-size: 21rpx;
  font-weight: 900;
}

.module {
  margin-top: 26rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: rgba(255, 252, 244, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(49, 71, 50, 0.08);
}

.module-title {
  margin-bottom: 14rpx;
}

.alert-item,
.family-card {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(82, 107, 85, 0.1);
}

.family-card {
  display: block;
}

.alert-item:last-child,
.family-card:last-child {
  border-bottom: 0;
}

.alert-level {
  flex: 0 0 72rpx;
  color: #526b55;
  font-size: 24rpx;
  font-weight: 900;
}

.alert-title,
.family-title,
.contact-value {
  color: #243832;
  font-size: 29rpx;
  font-weight: 900;
}

.alert-desc,
.family-desc {
  margin-top: 8rpx;
  color: rgba(36, 56, 50, 0.66);
  font-size: 24rpx;
  line-height: 1.45;
}

.emergency {
  margin-bottom: 40rpx;
}

.contact-grid {
  grid-template-columns: repeat(2, 1fr);
}

.contact-name {
  color: rgba(36, 56, 50, 0.62);
  font-size: 22rpx;
  font-weight: 900;
}

.contact-value {
  margin-top: 8rpx;
  font-size: 36rpx;
}
