/* cart.wxss */
body {
  font-family: Arial, sans-serif;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  background-color: #f4f4ec;
}

.cart-header {
  display: flex;
  justify-content: flex-start;
  padding: 15px;
  background-color: #f8f8f8;
  font-size: 20px;
  font-weight: bold;
}

#cart-count {
  margin-left: 5px;
}

.cart-items {
  height: calc(100vh - 180px); /* 增加高度以排除头部和底部 */
  overflow-y: scroll;
  background-color: #f4f4ec;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 10px;
  border-bottom: 1px solid #eee;
  position: relative;
  background-color: #fff;
  transition: transform 0.3s; /* 添加平滑的滑动效果 */
}

.item-image {
  width: 60px;
  height: 60px;
  object-fit: cover;
}

.details {
  flex: 1;
  margin-left: 10px;
}

.name {
  font-weight: bold;
  font-size: 16px;
}

.specifications {
  color: #888;
  font-size: 14px;
  margin-top: 5px;
}

.discount {
  color: #ff6700;
  font-size: 14px;
  margin-top: 5px;
}

.quantity-control {
  display: flex;
  align-items: center;
  margin-top: 5px;
}

.decrease, .increase {
  width: 25px; /* 更短的按钮区域 */
  height: 25px;
  background-color: #ddd;
  border: none;
  color: #333;
  font-size: 16px;
  text-align: center;
  line-height: 25px;
}

.quantity {
  width: 30px;
  height: 25px;
  text-align: center;
  margin: 0 5px;
  border: 1px solid #ddd;
}

.price {
  color: #f60;
  font-weight: bold;
}

.select-button {
  margin-right: 10px;
}

.swipe-actions {
  position: absolute;
  right: -160px; /* 调整为适合的宽度 */
  display: flex;
  height: 100%;
  top: 0;
  transition: right 0.3s;
}

.action {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 80px; /* 保持操作区域宽度 */
  height: 100%;
  color: white;
  cursor: pointer;
}

.share {
  background-color: #4CAF50;
}

.delete {
  background-color: #F44336;
}

.cart-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px;
  background-color: #e8e8d0; /* 与背景色对比明显 */
  position: fixed;
  bottom: 0;
  width: 100%;
  box-shadow: 0 -1px 5px rgba(0, 0, 0, 0.1);
}

.select-all {
  display: flex;
  align-items: center;
}

.total-price {
  font-size: 16px;
  margin-left: 20px; /* 留出距离 */
}

.price {
  color: #ff6700;
  font-weight: bold;
  font-size: 18px;
}

.checkout-button {
  padding: 8px 20px; /* 更窄的按钮 */
  color: white;
  border: none;
  cursor: pointer;
  background-color: grey;
  transition: background-color 0.3s;
}

.checkout-button.enabled {
  background-color: #ff6700;
}

.checkout-button.disabled {
  background-color: grey;
}

