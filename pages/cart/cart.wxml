<!-- cart.wxml -->
<view class="cart-header">
  <text>购物车</text>
  <text id="cart-count">({{cartCount}})</text>
</view>

<scroll-view class="cart-items" scroll-y="true">
  <!-- 渲染购物车商品 -->
  <block wx:for="{{cartItems}}" wx:key="id">
    <view class="cart-item" 
          data-id="{{item.id}}" 
          bindtouchstart="touchStart" 
          bindtouchmove="touchMove" 
          bindtouchend="touchEnd">
      <checkbox class="select-button" 
                value="{{item.id}}" 
                checked="{{item.selected}}" 
                bindchange="selectItem">
      </checkbox>
      <image src="{{item.imageUrl}}" class="item-image"></image>

      <view class="details">
        <view class="name">{{item.name}}</view>
        <view class="specifications">
          <text class="spec-label">规格：</text>{{item.specifications}}
        </view>
        <view class="discount">
          <text class="discount-text">{{item.discount ? '优惠：' + item.discount : ''}}</text>
        </view>
        <view class="quantity-control">
          <button class="decrease" data-id="{{item.id}}" bindtap="decreaseQuantity">-</button>
          <input class="quantity" value="{{item.quantity}}" data-id="{{item.id}}" bindinput="changeQuantity" />
          <button class="increase" data-id="{{item.id}}" bindtap="increaseQuantity">+</button>
        </view>
      </view>

      <view class="price">{{item.price}}</view>

      <view class="swipe-actions" style="right: {{item.swiped ? '0px' : '-160px'}};">
        <view class="action share" data-id="{{item.id}}" bindtap="shareItem">分享</view>
        <view class="action delete" data-id="{{item.id}}" bindtap="deleteItem">删除</view>
      </view>
    </view>
  </block>
</scroll-view>

<view class="cart-footer">
  <label class="select-all">
    <checkbox id="select-all-checkbox" bindchange="selectAll" checked="{{anySelected}}">全选</checkbox>
  </label>
  <view class="total-price">
    <text>总计：</text>
    <text class="price">{{totalPrice}}</text>
  </view>
  <button class="checkout-button {{anySelected ? 'enabled' : 'disabled'}}" bindtap="checkout">一起结算</button>
</view>
