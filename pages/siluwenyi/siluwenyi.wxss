page {
  background: #efe2cb;
}

.page {
  min-height: 100vh;
  height: 100vh;
  box-sizing: border-box;
  color: #382d22;
  background:
    radial-gradient(circle at 82% 6%, rgba(37, 112, 118, 0.18), transparent 30%),
    radial-gradient(circle at 8% 34%, rgba(190, 126, 62, 0.18), transparent 28%),
    linear-gradient(180deg, #fbf2df 0%, #ead8b8 58%, #e5cba5 100%);
}

.page-siluwenyi {
  padding: 76rpx 30rpx 54rpx;
}

.back-button {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  padding: 0 22rpx;
  margin-bottom: 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 250, 238, 0.82);
  color: #60482c;
  font-size: 25rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 18rpx rgba(70, 47, 24, 0.1);
}

.hero {
  position: relative;
  display: flex;
  min-height: 372rpx;
  padding: 38rpx 34rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(58, 43, 31, 0.92), rgba(117, 82, 43, 0.78)),
    url("https://free.picui.cn/free/2026/06/21/6a377a096c7f3.png");
  background-size: cover;
  background-position: center;
  box-shadow: 0 20rpx 44rpx rgba(72, 47, 22, 0.22);
}

.hero::after {
  content: "";
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 26rpx;
  height: 2rpx;
  background: rgba(255, 224, 163, 0.4);
}

.hero-copy {
  position: relative;
  z-index: 1;
  flex: 1;
  padding-right: 22rpx;
}

.eyebrow {
  color: rgba(255, 224, 163, 0.82);
  font-size: 22rpx;
  font-weight: 800;
}

.title {
  margin-top: 12rpx;
  color: #fff1d4;
  font-size: 64rpx;
  line-height: 1.02;
  font-weight: 900;
  letter-spacing: 0;
}

.subtitle {
  margin-top: 18rpx;
  color: rgba(255, 244, 219, 0.8);
  font-size: 27rpx;
  line-height: 1.55;
}

.hero-panel {
  position: relative;
  z-index: 1;
  flex: 0 0 186rpx;
  align-self: flex-end;
  padding: 24rpx 20rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 226, 166, 0.36);
  border-radius: 8rpx;
  background: rgba(28, 23, 19, 0.48);
  color: #fff0cf;
  text-align: center;
}

.panel-kicker,
.panel-unit {
  color: rgba(255, 238, 205, 0.68);
  font-size: 20rpx;
}

.panel-route {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.28;
}

.panel-score {
  margin-top: 12rpx;
  font-size: 54rpx;
  line-height: 1;
  font-weight: 900;
}

.module {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: rgba(255, 251, 242, 0.9);
  box-shadow: 0 14rpx 32rpx rgba(74, 49, 23, 0.1);
}

.dark-module {
  background: linear-gradient(135deg, #2d271f, #5c432b);
  color: #fff0cf;
}

.module-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.module-title {
  color: #3f3020;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 900;
}

.module-subtitle {
  margin-top: 8rpx;
  color: rgba(63, 48, 32, 0.58);
  font-size: 24rpx;
  line-height: 1.35;
}

.light {
  color: #fff0cf;
}

.light-sub {
  color: rgba(255, 238, 205, 0.64);
}

.required-mark {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #382d22;
  color: #fff0cf;
  font-size: 22rpx;
  font-weight: 800;
}

.history-row {
  margin-top: 22rpx;
}

.history-card {
  display: flex;
  align-items: center;
  min-height: 68rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f5ead8;
  color: #60482c;
  font-size: 25rpx;
  font-weight: 800;
}

.history-card text {
  margin-left: 8rpx;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.field,
.choice-section {
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #765633;
  font-size: 26rpx;
  font-weight: 900;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #f7eedf;
  color: #382d22;
  font-size: 26rpx;
}

.input {
  height: 76rpx;
  padding: 0 20rpx;
}

.textarea {
  min-height: 150rpx;
  padding: 18rpx 20rpx;
  line-height: 1.45;
}

.choice-row,
.choice-grid {
  display: flex;
  flex-wrap: wrap;
}

.choice {
  display: flex;
  align-items: center;
  min-height: 58rpx;
  padding: 0 18rpx;
  margin: 0 14rpx 14rpx 0;
  border: 2rpx solid rgba(117, 82, 43, 0.14);
  border-radius: 999rpx;
  color: #765633;
  font-size: 25rpx;
  background: #f5ead8;
}

.choice text {
  margin-left: 4rpx;
}

.choice--active {
  border-color: rgba(56, 45, 34, 0.8);
  background: #382d22;
  color: #fff0cf;
}

.error-box {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  background: rgba(166, 54, 39, 0.12);
  color: #9d392b;
  font-size: 24rpx;
  line-height: 1.4;
}

.submit-button {
  height: 90rpx;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 90rpx;
}

.submit-button {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #6d4f2d, #34281e);
  color: #fff0cf;
  box-shadow: 0 14rpx 30rpx rgba(70, 47, 24, 0.22);
}

.submit-button--loading {
  opacity: 0.86;
}

.submit-button::after {
  border: 0;
}

.process-list {
  margin-top: 24rpx;
}

.process-item {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(255, 238, 205, 0.1);
}

.process-item:last-child {
  border-bottom: 0;
}

.process-dot {
  flex: 0 0 26rpx;
  width: 26rpx;
  height: 26rpx;
  margin: 8rpx 18rpx 0 0;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 238, 205, 0.36);
  box-sizing: border-box;
}

.process-item--active .process-dot {
  border-color: #ffe1a3;
  background: #ffe1a3;
  box-shadow: 0 0 22rpx rgba(255, 225, 163, 0.6);
  animation: pulse 1.2s ease-in-out infinite;
}

.process-item--done .process-dot {
  border-color: #b8d9b5;
  background: #b8d9b5;
}

.process-item--error .process-dot {
  border-color: #e49a80;
  background: #e49a80;
}

.process-copy {
  flex: 1;
}

.process-title {
  color: #fff0cf;
  font-size: 29rpx;
  font-weight: 900;
}

.process-desc {
  margin-top: 8rpx;
  color: rgba(255, 238, 205, 0.68);
  font-size: 24rpx;
  line-height: 1.42;
}

.result-module {
  margin-bottom: 30rpx;
}

.report-hero {
  margin-top: 22rpx;
  padding: 30rpx;
  border-radius: 18rpx;
  background:
    linear-gradient(135deg, rgba(56, 45, 34, 0.94), rgba(47, 104, 96, 0.82)),
    url("https://free.picui.cn/free/2026/06/20/6a35650c75aa2.png");
  background-size: cover;
  background-position: center;
  box-shadow: 0 20rpx 44rpx rgba(56, 45, 34, 0.18);
}

.report-title {
  color: #fff4dc;
  font-size: 38rpx;
  line-height: 1.22;
  font-weight: 900;
}

.report-chip-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.report-chip {
  margin: 0 12rpx 12rpx 0;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 244, 220, 0.14);
  color: rgba(255, 244, 220, 0.92);
  font-size: 22rpx;
  font-weight: 800;
}

.trip-info-panel {
  margin-top: 18rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background:
    radial-gradient(circle at 92% 2%, rgba(232, 181, 90, 0.22), transparent 30%),
    linear-gradient(180deg, #fffaf0, #f4ead9 62%, #efe0c8);
  border: 2rpx solid rgba(117, 82, 43, 0.12);
  box-shadow: 0 18rpx 42rpx rgba(74, 49, 23, 0.12);
}

.trip-info-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.trip-info-kicker {
  color: #2f6860;
  font-size: 21rpx;
  font-weight: 900;
}

.trip-info-title {
  margin-top: 8rpx;
  color: #382d22;
  font-size: 34rpx;
  line-height: 1.16;
  font-weight: 900;
}

.trip-info-subtitle {
  margin-top: 8rpx;
  color: rgba(56, 45, 34, 0.58);
  font-size: 23rpx;
  line-height: 1.38;
}

.trip-map-button {
  flex: 0 0 auto;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #fff0cf;
  font-size: 24rpx;
  line-height: 58rpx;
  font-weight: 900;
  background: #382d22;
}

.trip-summary-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 12rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.46);
}

.trip-summary-card {
  min-height: 98rpx;
  padding: 16rpx 8rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
  text-align: center;
  background: rgba(56, 45, 34, 0.06);
}

.trip-summary-value {
  color: #382d22;
  font-size: 30rpx;
  line-height: 1.15;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trip-summary-label {
  margin-top: 8rpx;
  color: rgba(56, 45, 34, 0.52);
  font-size: 21rpx;
  font-weight: 800;
}

.trip-day-scroll {
  margin: 24rpx -26rpx 0;
  white-space: nowrap;
}

.trip-day-track {
  display: inline-flex;
  padding: 0 26rpx;
}

.trip-day-tab {
  width: 138rpx;
  height: 72rpx;
  margin-right: 14rpx;
  padding: 0 16rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.56);
  border: 1rpx solid rgba(117, 82, 43, 0.08);
}

.trip-day-tab--active {
  background: linear-gradient(135deg, #382d22, #2f6860);
  border-color: transparent;
  box-shadow: 0 12rpx 24rpx rgba(56, 45, 34, 0.16);
}

.trip-day-label {
  color: #9b7245;
  font-size: 25rpx;
  line-height: 72rpx;
  text-align: center;
  font-weight: 900;
}

.trip-day-tab--active .trip-day-label {
  color: #ffe1a3;
}

.trip-day-detail {
  margin-top: 22rpx;
}

.trip-route-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background:
    linear-gradient(135deg, rgba(56, 45, 34, 0.96), rgba(47, 104, 96, 0.9)),
    url("https://free.picui.cn/free/2026/06/24/6a3b89a3e9552.jpg");
  background-size: cover;
  background-position: center;
  box-shadow: 0 16rpx 32rpx rgba(56, 45, 34, 0.16);
}

.trip-route-day {
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  color: #382d22;
  font-size: 24rpx;
  line-height: 76rpx;
  text-align: center;
  font-weight: 900;
  background: #ffe1a3;
}

.trip-route-main {
  flex: 1;
  min-width: 0;
}

.trip-route-title {
  color: #fff0cf;
  font-size: 30rpx;
  line-height: 1.28;
  font-weight: 900;
}

.trip-route-sub {
  margin-top: 8rpx;
  color: rgba(255, 240, 207, 0.66);
  font-size: 22rpx;
  line-height: 1.36;
}

.trip-info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.trip-info-card {
  min-height: 118rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(117, 82, 43, 0.08);
}

.trip-card-label {
  color: #967145;
  font-size: 21rpx;
  font-weight: 900;
}

.trip-card-text {
  margin-top: 10rpx;
  color: #382d22;
  font-size: 24rpx;
  line-height: 1.42;
  font-weight: 900;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.timeline {
  margin-top: 24rpx;
  padding: 22rpx 20rpx 0;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(117, 82, 43, 0.08);
}

.timeline-node {
  position: relative;
  display: flex;
  padding-bottom: 26rpx;
}

.timeline-node::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 32rpx;
  bottom: -2rpx;
  width: 2rpx;
  border-left: 2rpx dashed rgba(117, 82, 43, 0.28);
}

.timeline-node--last::before {
  display: none;
}

.timeline-dot {
  position: relative;
  z-index: 1;
  flex: 0 0 30rpx;
  width: 30rpx;
  height: 30rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  border: 6rpx solid #fff8ea;
  box-sizing: border-box;
  background: #765633;
  box-shadow: 0 0 0 2rpx rgba(117, 82, 43, 0.28);
}

.timeline-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  padding: 0 0 2rpx;
  border-radius: 0;
  background: transparent;
}

.timeline-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.timeline-name {
  flex: 1;
  color: #382d22;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 900;
}

.timeline-time {
  flex: 0 0 auto;
  max-width: 190rpx;
  color: #9b7245;
  font-size: 22rpx;
  line-height: 1.28;
  text-align: right;
  font-weight: 900;
}

.timeline-meta,
.timeline-ticket {
  margin-top: 10rpx;
  color: rgba(56, 45, 34, 0.58);
  font-size: 22rpx;
  line-height: 1.38;
  font-weight: 800;
}

.timeline-ticket {
  color: #2f6860;
}

.trip-long-card {
  margin-top: 12rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(47, 104, 96, 0.09);
  border-left: 6rpx solid #2f6860;
}

.trip-long-card--ticket {
  background: rgba(117, 82, 43, 0.08);
  border-left-color: #a07748;
}

.trip-long-label {
  color: #967145;
  font-size: 22rpx;
  font-weight: 900;
}

.trip-long-text {
  margin-top: 8rpx;
  color: rgba(56, 45, 34, 0.76);
  font-size: 24rpx;
  line-height: 1.5;
}

.trip-section-title {
  margin-top: 22rpx;
  color: #382d22;
  font-size: 28rpx;
  font-weight: 900;
}

.trip-meal-list {
  margin-top: 12rpx;
}

.trip-meal-card {
  margin-bottom: 12rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(117, 82, 43, 0.08);
}

.trip-meal-title {
  color: #967145;
  font-size: 22rpx;
  font-weight: 900;
}

.trip-meal-text {
  margin-top: 8rpx;
  color: rgba(56, 45, 34, 0.78);
  font-size: 24rpx;
  line-height: 1.45;
}

.trip-notice-list {
  margin-top: 12rpx;
}

.trip-notice-item {
  position: relative;
  margin-bottom: 10rpx;
  padding: 14rpx 18rpx 14rpx 42rpx;
  border-radius: 14rpx;
  color: rgba(56, 45, 34, 0.74);
  font-size: 23rpx;
  line-height: 1.42;
  background: rgba(47, 104, 96, 0.08);
}

.trip-notice-item::before {
  content: "";
  position: absolute;
  left: 18rpx;
  top: 26rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #2f6860;
}

.trip-action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 22rpx;
}

.trip-action {
  height: 72rpx;
  border-radius: 14rpx;
  color: #60482c;
  font-size: 24rpx;
  line-height: 72rpx;
  text-align: center;
  font-weight: 900;
  background: rgba(117, 82, 43, 0.1);
}

.trip-action--dark {
  color: #fff0cf;
  background: #382d22;
}

.report-tips {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #382d22;
  color: #fff0cf;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 900;
}

.tips-item {
  margin-top: 12rpx;
  color: rgba(255, 240, 207, 0.82);
  font-size: 24rpx;
  line-height: 1.45;
}

@keyframes pulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.78;
  }

  50% {
    transform: scale(1.25);
    opacity: 1;
  }
}
