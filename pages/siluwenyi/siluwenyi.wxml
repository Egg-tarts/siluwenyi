<view class="container">
  <view class="header">行程定制表单</view>
  <view class="form">
    <form bindsubmit="formSubmit" report-submit="true">
      <checkbox-group name="recommendation">
        <label><checkbox value="推荐" />根据过往行程进行推荐</label>
      </checkbox-group>

      <view class="section">
        <text class="section-title">1. 整体预算</text>
        <radio-group name="accommodation">
          <label><radio value="低" />低</label>
          <label><radio value="中" />中</label>
          <label><radio value="高" />高</label>
        </radio-group>
      </view>

      <view class="section">
        <text class="section-title">2. 景点偏好</text>
        <checkbox-group name="scenery">
          <label><checkbox value="博物馆/艺术馆" />博物馆/艺术馆</label>
          <label><checkbox value="人文景观" />人文景观</label>
          <label><checkbox value="自然景观" />自然景观</label>
          <label><checkbox value="特色美食" />特色美食</label>
        </checkbox-group>
      </view>

      <view class="section">
        <text class="section-title">3. 出行人员</text>
        <view class="person-item">
          <text>成员年龄（用逗号隔开）</text>
          <input name="age1" type="number" placeholder="年龄" />
        </view>
      </view>

      <view class="section">
        <text class="section-title">4. 出行时间</text>
        <radio-group name="cities">
          <label><radio value="一天" />一天</label>
          <label><radio value="两天" />两天</label>
          <label><radio value="三天" />三天</label>
          <label><radio value="四天" />四天</label>
          <label><radio value="五天" />五天</label>
          <label><radio value="六天" />六天</label>
          <label><radio value="七天" />七天</label>
          <label><radio value="八天" />八天</label>
        </radio-group>
      </view>

      <button class="submit-button" formType="submit">生成行程</button>
    </form>
  </view>
</view>
