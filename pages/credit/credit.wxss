/* 页面整体容器 */
.container {
  background-color:#f4f4ec;
}

/* 左侧分类栏 */
.sidebar {
  top:0;
  width: 22%; /* 分类栏占页面宽度的 15% */
  background-color: #f3e9d2;
  border-right: 1px solid #ddd;
  display: flex;
  flex-direction: column;
  align-items: flex-start; /* 分类项左对齐 */
  overflow-y: auto;
  position: fixed; /* 使得分类栏固定在左侧 */
  height: 100%; /* 高度为100% */
  left: 0; /* 确保分类栏位于最左侧 */
}

/* 单个分类项 */
.category-item {
  padding: 30rpx;
  cursor: pointer;
  border-bottom: 2px solid #e0e0e0;
  text-align:left; /* 分类项文本左对齐 */
  width: 150%;
  font-size: 28rpx;
  transition: background-color 0.3s ease, color 0.3s ease;
}

/* 分类项激活状态 */
.category-item.active {
  background-color: #f5d56e;
  color: #f4f4ec;
  font-weight: bold;
}

/* 分类名称 */
.category-name {
  color: #333;
}

/* 右侧商品展示区域 */
.content {
  top: 0%;
  margin-left: 18%; /* 商品展示区域左侧边距与分类栏宽度相同 */
  background-color: #f4f4ec;
  padding: 10rpx;
  overflow-y: auto;
  height: 100vh; /* 确保商品区域占满整个页面高度 */
  padding-left: 20rpx; /* 给商品区域添加一些内边距 */
}

/* 分类标题 */
.category-title {
  top: 0%;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 25rpx;
}

/* 商品列表 */
.product-list {
  top:0%;
  display: grid;
  grid-template-columns: repeat(1, 1fr); 
  gap: 30rpx;
  justify-items: center;

}

/* 单个商品项 */
.product {
  width: 100%;
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 17rpx;
  text-align: center;
  transition: transform 0.3s ease;
  width: 250px;
  height:200px

}

.product:hover {
  transform: scale(1.05); /* 鼠标悬停时放大 */
}

/* 商品图片 */
.product-image {
  width: 100%;
  height: 280rpx;
  object-fit: cover;
  border-radius: 5rpx;
  
}

/* 商品信息 */
.product-info {
  margin-top: 10rpx;
}

.product-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.product-requirement {
  font-size: 20rpx;
  color: #666;
  margin-top: 5rpx;
}
