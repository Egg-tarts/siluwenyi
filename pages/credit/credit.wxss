page {
  background: #f4efe4;
}

.credit-page {
  min-height: 100vh;
  height: 100vh;
  box-sizing: border-box;
  padding: 76rpx 30rpx 60rpx;
  color: #31291e;
  background: linear-gradient(180deg, #f7f2e7, #efe3cf);
}

.back-button {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 252, 244, 0.72);
  color: #6c5437;
  font-size: 25rpx;
  font-weight: 900;
}

.hero {
  margin-top: 22rpx;
  padding: 34rpx 30rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #765633, #c0985b);
  color: #fff7e8;
  box-shadow: 0 14rpx 32rpx rgba(82, 66, 41, 0.16);
}

.hero-title {
  font-size: 48rpx;
  font-weight: 900;
}

.hero-subtitle,
.progress-text {
  margin-top: 12rpx;
  color: rgba(255, 247, 232, 0.76);
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 800;
}

.level-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
}

.level-badge {
  height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 247, 232, 0.18);
  line-height: 54rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.points {
  font-size: 42rpx;
  font-weight: 900;
}

.progress-track {
  height: 16rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 247, 232, 0.24);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #fff7e8;
}

.section-title {
  margin-top: 34rpx;
  color: #1f1b14;
  font-size: 38rpx;
  font-weight: 900;
}

.gift-list {
  margin-top: 20rpx;
}

.gift-card {
  display: flex;
  margin-bottom: 18rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: rgba(255, 252, 244, 0.84);
  box-shadow: 0 10rpx 24rpx rgba(82, 66, 41, 0.1);
}

.gift-card.disabled {
  opacity: 0.74;
}

.gift-image {
  width: 190rpx;
  height: 186rpx;
  border-radius: 8rpx;
}

.gift-info {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
}

.gift-tag {
  display: inline-flex;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #efe0c4;
  color: #856239;
  font-size: 20rpx;
  font-weight: 900;
}

.gift-name {
  margin-top: 12rpx;
  color: #33281d;
  font-size: 30rpx;
  font-weight: 900;
}

.gift-desc {
  margin-top: 8rpx;
  color: rgba(51, 40, 29, 0.62);
  font-size: 23rpx;
  line-height: 1.4;
}

.gift-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.gift-points {
  color: #765633;
  font-size: 24rpx;
  font-weight: 900;
}

.gift-button {
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #765633;
  color: #fff7e8;
  font-size: 21rpx;
  line-height: 48rpx;
  font-weight: 900;
}

.task-panel {
  margin-top: 18rpx;
  border-radius: 8rpx;
  background: rgba(255, 252, 244, 0.84);
  box-shadow: 0 10rpx 24rpx rgba(82, 66, 41, 0.1);
}

.task-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 2rpx solid rgba(124, 90, 53, 0.08);
}

.task-item:last-child {
  border-bottom: 0;
}

.task-title {
  color: #33281d;
  font-size: 28rpx;
  font-weight: 900;
}

.task-desc {
  margin-top: 8rpx;
  color: rgba(51, 40, 29, 0.58);
  font-size: 23rpx;
}

.task-points {
  color: #765633;
  font-size: 24rpx;
  font-weight: 900;
}
