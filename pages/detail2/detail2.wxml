<view class="container">
  <!-- 头部 -->
  <view class="header-container">
    <view class="header-content">
      <view class="header-icon">🗺️</view>
      <text class="header-text">我的行程</text>
      <view class="header-subtitle">精心规划的旅行体验</view>
    </view>
  </view>

  <!-- 中间的左右布局 -->
  <view class="main-container">
    <!-- 左侧按钮区 -->
    <view class="button-container">
      <view class="tab-button {{showScheduleTab ? 'active' : ''}}" bindtap="showSchedule">
        <view class="tab-icon">📅</view>
        <text class="tab-text">行程安排</text>
      </view>
      <view class="tab-button {{!showScheduleTab ? 'active' : ''}}" bindtap="showRestaurants">
        <view class="tab-icon">🍽️</view>
        <text class="tab-text">美食安排</text>
      </view>
    </view>

    <!-- 右侧内容区 -->
    <view class="content-container">
      <!-- 行程安排内容 -->
      <view wx:if="{{showScheduleTab}}" class="content-section">
        <view class="section-header">
          <view class="section-icon">🎯</view>
          <text class="section-title">每日行程</text>
        </view>
        <scroll-view scroll-y class="scroll-view">
          <view wx:for="{{travelPlans}}" wx:key="index" class="schedule-item">
            <view class="day-header">
              <view class="day-number">{{index + 1}}</view>
              <text class="day-text">第{{index + 1}}天</text>
            </view>
            <view class="schedule-card">
              <view class="card-header">
                <view class="attraction-icon">🏛️</view>
                <text class="attraction-title">{{item.attraction}}</text>
              </view>
              <view class="card-content">
                <view class="transport-info">
                  <view class="transport-icon">🚗</view>
                  <text class="transport-text">{{item.transport}}</text>
                </view>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 美食安排内容 -->
      <view wx:if="{{!showScheduleTab}}" class="content-section">
        <view class="section-header">
          <view class="section-icon">🍴</view>
          <text class="section-title">美食推荐</text>
        </view>
        <scroll-view scroll-y class="scroll-view">
          <view wx:for="{{travelPlans}}" wx:key="index" class="schedule-item">
            <view class="day-header">
              <view class="day-number">{{index + 1}}</view>
              <text class="day-text">第{{index + 1}}天</text>
            </view>
            <view class="schedule-card">
              <view class="card-header">
                <view class="attraction-icon">🍽️</view>
                <text class="attraction-title">{{item.restaurants[0] ? item.restaurants[0].name : '暂无推荐'}}</text>
              </view>
              <view class="card-content">
                <view class="transport-info">
                  <view class="transport-icon">📍</view>
                  <text class="transport-text">{{item.restaurants[0] ? item.restaurants[0].address : ''}}</text>
                </view>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>
</view>
