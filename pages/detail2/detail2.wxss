/* 页面样式 */
.container {
  display: flex;
  flex-direction: column;
  background: #f4f4ec;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  padding-top: 0;
}

/* 头部样式 */
.header-container {
  padding: 20rpx 0;
  text-align: center;
  position: relative;
  width: 100%;
  background: #f4f4ec;
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.header-icon {
  font-size: 44rpx;
  margin-bottom: 6rpx;
}

.header-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #b8860b;
  margin-bottom: 4rpx;
}

.header-subtitle {
  font-size: 22rpx;
  color: #a67c00;
  font-weight: 400;
}

/* 主容器样式 */
.main-container {
  display: flex;
  flex: 1;
  width: 100%;
  background: #f4f4ec;
  margin-top: 10rpx;
}

/* 左侧标签按钮容器 */
.button-container {
  width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  box-shadow: 2rpx 0 20rpx rgba(184, 134, 11, 0.08);
}

.tab-button {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  cursor: pointer;
  box-shadow: 0 4rpx 15rpx rgba(184, 134, 11, 0.08);
}

.tab-button.active {
  background: linear-gradient(135deg, #ffe9b0 0%, #b8860b 100%);
  border-color: #b8860b;
  transform: translateY(-5rpx);
  box-shadow: 0 8rpx 25rpx rgba(184, 134, 11, 0.18);
}

.tab-button:not(.active):hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 20rpx rgba(184, 134, 11, 0.15);
}

.tab-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.tab-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #b8860b;
  text-align: center;
}

.tab-button.active .tab-text {
  color: white;
}

/* 右侧内容容器 */
.content-container {
  flex: 1;
  padding: 30rpx;
  background: #f4f4ec;
}

.content-section {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 20rpx 30rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(184, 134, 11, 0.08);
}

.section-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #b8860b;
}

/* 滚动视图 */
.scroll-view {
  flex: 1;
  padding-bottom: 30rpx;
}

/* 行程项目样式 */
.schedule-item {
  margin-bottom: 30rpx;
}

.day-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.day-number {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #ffe9b0 0%, #b8860b 100%);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(184, 134, 11, 0.18);
}

.day-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #b8860b;
}

/* 行程卡片样式 */
.schedule-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(184, 134, 11, 0.10);
  border: 1rpx solid rgba(184, 134, 11, 0.10);
  transition: all 0.3s ease;
}

.schedule-card:hover {
  transform: translateY(-5rpx);
  box-shadow: 0 12rpx 40rpx rgba(184, 134, 11, 0.15);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #ffe9b0;
}

.attraction-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}

.attraction-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #b8860b;
  flex: 1;
}

.card-content {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.transport-info {
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  background: #fff8e1;
  border-radius: 15rpx;
  border-left: 4rpx solid #b8860b;
}

.transport-icon {
  font-size: 28rpx;
  margin-right: 15rpx;
}

.transport-text {
  font-size: 26rpx;
  color: #a67c00;
  font-weight: 500;
  line-height: 1.4;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .button-container {
    width: 150rpx;
    padding: 20rpx 10rpx;
  }
  
  .tab-button {
    width: 120rpx;
    height: 120rpx;
  }
  
  .content-container {
    padding: 20rpx;
  }
}
