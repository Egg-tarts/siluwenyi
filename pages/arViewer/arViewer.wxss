page {
  background: #141712;
}

.ar-page {
  min-height: 100vh;
  height: 100vh;
  box-sizing: border-box;
  padding: 58rpx 28rpx 0;
  color: #fff4dc;
  background:
    radial-gradient(circle at 80% 6%, rgba(214, 154, 76, 0.22), transparent 28%),
    radial-gradient(circle at 12% 32%, rgba(67, 116, 104, 0.2), transparent 34%),
    linear-gradient(180deg, #141712 0%, #243028 42%, #17130f 100%);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 68rpx;
}

.back-button {
  height: 54rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(255, 244, 220, 0.18);
  border-radius: 999rpx;
  color: #fff4dc;
  font-size: 24rpx;
  line-height: 54rpx;
  background: rgba(255, 244, 220, 0.1);
}

.top-title {
  color: #fff4dc;
  font-size: 32rpx;
  font-weight: 900;
}

.hero-panel,
.creator-panel,
.progress-panel,
.guide-card {
  border: 1rpx solid rgba(255, 231, 174, 0.18);
  border-radius: 8rpx;
  background: rgba(255, 244, 220, 0.1);
  box-shadow: 0 24rpx 56rpx rgba(0, 0, 0, 0.18), inset 0 0 44rpx rgba(255, 240, 198, 0.04);
}

.hero-panel {
  position: relative;
  margin-top: 28rpx;
  padding: 34rpx 30rpx 30rpx;
  overflow: hidden;
}

.hero-panel::after {
  content: "";
  position: absolute;
  right: -80rpx;
  bottom: -96rpx;
  width: 260rpx;
  height: 260rpx;
  border: 1rpx solid rgba(255, 227, 168, 0.16);
  border-radius: 50%;
}

.hero-kicker,
.section-kicker {
  color: rgba(255, 227, 168, 0.76);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.hero-title {
  margin-top: 12rpx;
  color: #fff4dc;
  font-size: 46rpx;
  line-height: 1.16;
  font-weight: 900;
}

.hero-desc {
  width: 92%;
  margin-top: 16rpx;
  color: rgba(255, 244, 220, 0.72);
  font-size: 25rpx;
  line-height: 1.58;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.hero-tag {
  height: 48rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 227, 168, 0.25);
  border-radius: 999rpx;
  color: #ffe3a8;
  font-size: 22rpx;
  line-height: 48rpx;
  background: rgba(255, 227, 168, 0.08);
}

.camera-stage {
  position: relative;
  height: 650rpx;
  margin-top: 26rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 231, 174, 0.28);
  border-radius: 8rpx;
  box-shadow: 0 24rpx 52rpx rgba(0, 0, 0, 0.28);
}

.camera-view,
.camera-fallback,
.camera-shade {
  position: absolute;
  width: 100%;
  height: 100%;
}

.camera-view,
.camera-fallback {
  z-index: 0;
}

.camera-shade {
  z-index: 1;
  background:
    linear-gradient(180deg, rgba(8, 14, 12, 0.06), rgba(8, 14, 12, 0.48)),
    radial-gradient(circle at 50% 40%, rgba(255, 226, 155, 0.14), transparent 34%);
}

.motion-ring {
  position: absolute;
  z-index: 3;
  border: 2rpx solid rgba(255, 227, 168, 0.26);
  border-radius: 50%;
  animation: ringFloat 5s ease-in-out infinite;
}

.ring-a {
  left: 90rpx;
  top: 150rpx;
  width: 250rpx;
  height: 250rpx;
}

.ring-b {
  right: 78rpx;
  bottom: 126rpx;
  width: 190rpx;
  height: 190rpx;
  animation-delay: 1.2s;
}

.corner {
  position: absolute;
  z-index: 4;
  width: 56rpx;
  height: 56rpx;
  border-color: rgba(255, 232, 174, 0.88);
}

.corner-a {
  top: 28rpx;
  left: 28rpx;
  border-top: 5rpx solid;
  border-left: 5rpx solid;
}

.corner-b {
  top: 28rpx;
  right: 28rpx;
  border-top: 5rpx solid;
  border-right: 5rpx solid;
}

.corner-c {
  bottom: 28rpx;
  left: 28rpx;
  border-bottom: 5rpx solid;
  border-left: 5rpx solid;
}

.corner-d {
  right: 28rpx;
  bottom: 28rpx;
  border-right: 5rpx solid;
  border-bottom: 5rpx solid;
}

.status-pill {
  position: absolute;
  z-index: 5;
  top: 30rpx;
  left: 38rpx;
  display: flex;
  align-items: center;
  max-width: 470rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #fff5db;
  font-size: 22rpx;
  font-weight: 800;
  background: rgba(16, 23, 19, 0.58);
}

.status-dot {
  flex: 0 0 14rpx;
  width: 14rpx;
  height: 14rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #94836a;
}

.status-dot--active {
  background: #70e0a4;
  box-shadow: 0 0 18rpx rgba(112, 224, 164, 0.72);
}

.camera-error {
  position: absolute;
  left: 42rpx;
  right: 42rpx;
  top: 108rpx;
  z-index: 5;
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  color: #fff5db;
  font-size: 24rpx;
  line-height: 1.45;
  background: rgba(129, 48, 36, 0.72);
}

.ar-label {
  position: absolute;
  z-index: 5;
  max-width: 440rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(255, 234, 188, 0.36);
  border-radius: 8rpx;
  background: rgba(16, 23, 19, 0.62);
}

.label-main {
  left: 44rpx;
  bottom: 118rpx;
}

.label-side {
  right: 36rpx;
  bottom: 34rpx;
  max-width: 330rpx;
}

.label-title {
  color: #fff0c0;
  font-size: 30rpx;
  font-weight: 900;
}

.label-desc {
  margin-top: 8rpx;
  color: rgba(255, 244, 220, 0.72);
  font-size: 22rpx;
  line-height: 1.35;
}

.camera-toolbar {
  display: grid;
  grid-template-columns: 1fr 108rpx 1fr;
  gap: 22rpx;
  align-items: center;
  margin-top: 22rpx;
}

.tool-button {
  height: 64rpx;
  border: 1rpx solid rgba(255, 244, 220, 0.16);
  border-radius: 999rpx;
  color: #fff4dc;
  font-size: 24rpx;
  line-height: 64rpx;
  text-align: center;
  font-weight: 900;
  background: rgba(255, 244, 220, 0.12);
}

.capture-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border: 4rpx solid rgba(255, 244, 220, 0.72);
  border-radius: 50%;
  box-sizing: border-box;
  background: rgba(255, 244, 220, 0.12);
}

.capture-core {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffe3a8;
}

.scene-scroll {
  margin: 24rpx -28rpx 0;
  white-space: nowrap;
}

.scene-track {
  display: inline-flex;
  padding: 0 28rpx;
}

.scene-chip {
  height: 58rpx;
  padding: 0 24rpx;
  margin-right: 14rpx;
  border: 1rpx solid rgba(255, 244, 220, 0.1);
  border-radius: 999rpx;
  color: rgba(255, 244, 220, 0.72);
  font-size: 24rpx;
  line-height: 58rpx;
  background: rgba(255, 244, 220, 0.1);
}

.scene-chip--active {
  color: #1f1b14;
  background: #ffe3a8;
  font-weight: 900;
}

.creator-panel,
.progress-panel,
.guide-card {
  margin-top: 26rpx;
  padding: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.section-title {
  color: #fff4dc;
  font-size: 34rpx;
  font-weight: 900;
}

.scene-use,
.url-button,
.video-action {
  flex: 0 0 auto;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #1e1a12;
  font-size: 23rpx;
  line-height: 56rpx;
  text-align: center;
  font-weight: 900;
  background: #ffe3a8;
}

.preview-box {
  position: relative;
  height: 330rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.18);
}

.preview-image {
  width: 100%;
  height: 100%;
}

.preview-box::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 58%;
  background: linear-gradient(180deg, transparent, rgba(10, 14, 12, 0.82));
}

.preview-meta {
  position: absolute;
  z-index: 2;
  left: 24rpx;
  right: 24rpx;
  bottom: 22rpx;
}

.preview-title {
  color: #fff2c8;
  font-size: 30rpx;
  font-weight: 900;
}

.preview-desc {
  margin-top: 8rpx;
  color: rgba(255, 244, 220, 0.72);
  font-size: 22rpx;
  line-height: 1.42;
}

.url-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin-top: 22rpx;
}

.url-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(255, 244, 220, 0.12);
  border-radius: 8rpx;
  color: #fff4dc;
  font-size: 23rpx;
  background: rgba(255, 244, 220, 0.08);
}

.prompt-label,
.setting-title {
  margin-top: 26rpx;
  color: #fff4dc;
  font-size: 26rpx;
  font-weight: 900;
}

.preset-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
}

.preset-current {
  margin-top: 8rpx;
  color: rgba(255, 244, 220, 0.52);
  font-size: 22rpx;
  font-weight: 800;
}

.custom-toggle {
  flex: 0 0 auto;
  height: 52rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 227, 168, 0.24);
  border-radius: 999rpx;
  color: #ffe3a8;
  font-size: 22rpx;
  line-height: 52rpx;
  font-weight: 900;
  background: rgba(255, 227, 168, 0.08);
}

.preset-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.preset-card {
  min-height: 126rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 244, 220, 0.12);
  border-radius: 8rpx;
  box-sizing: border-box;
  background: rgba(255, 244, 220, 0.08);
}

.preset-card--active {
  border-color: rgba(255, 227, 168, 0.78);
  background: rgba(255, 227, 168, 0.16);
  box-shadow: inset 0 0 28rpx rgba(255, 227, 168, 0.08);
}

.preset-title {
  color: #fff4dc;
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 900;
}

.preset-desc {
  margin-top: 10rpx;
  color: rgba(255, 244, 220, 0.56);
  font-size: 21rpx;
  line-height: 1.36;
}

.custom-prompt-panel {
  margin-top: 16rpx;
}

.custom-prompt-tip {
  color: rgba(255, 244, 220, 0.52);
  font-size: 22rpx;
  line-height: 1.42;
}

.prompt-input {
  width: 100%;
  height: 230rpx;
  margin-top: 14rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 244, 220, 0.13);
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #fff4dc;
  font-size: 24rpx;
  line-height: 1.52;
  background: rgba(255, 244, 220, 0.08);
}

.setting-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
}

.option-row {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.option-row--compact {
  flex-wrap: wrap;
}

.option {
  flex: 1;
  min-width: 128rpx;
  height: 58rpx;
  border: 1rpx solid rgba(255, 244, 220, 0.1);
  border-radius: 8rpx;
  color: rgba(255, 244, 220, 0.72);
  font-size: 23rpx;
  line-height: 58rpx;
  text-align: center;
  background: rgba(255, 244, 220, 0.08);
}

.option--active {
  color: #1f1b14;
  font-weight: 900;
  background: #ffe3a8;
}

.switch-row {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.switch-item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 68rpx;
  border: 1rpx solid rgba(255, 244, 220, 0.12);
  border-radius: 8rpx;
  color: rgba(255, 244, 220, 0.78);
  font-size: 24rpx;
  background: rgba(255, 244, 220, 0.08);
}

.switch-dot {
  width: 24rpx;
  height: 24rpx;
  margin-right: 12rpx;
  border: 2rpx solid rgba(255, 227, 168, 0.5);
  border-radius: 50%;
}

.switch-dot--active {
  border-color: #ffe3a8;
  background: #ffe3a8;
  box-shadow: 0 0 18rpx rgba(255, 227, 168, 0.36);
}

.generate-button {
  height: 88rpx;
  margin-top: 28rpx;
  border-radius: 8rpx;
  color: #1e1a12;
  font-size: 30rpx;
  line-height: 88rpx;
  text-align: center;
  font-weight: 900;
  background: linear-gradient(90deg, #ffe3a8 0%, #d89b55 100%);
  box-shadow: 0 16rpx 34rpx rgba(216, 155, 85, 0.28);
}

.generate-button--loading {
  opacity: 0.78;
  animation: pulse 1.2s ease-in-out infinite;
}

.task-id {
  max-width: 310rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: rgba(255, 244, 220, 0.55);
  font-size: 20rpx;
}

.progress-line {
  position: relative;
  height: 12rpx;
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 244, 220, 0.12);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #70e0a4 0%, #ffe3a8 55%, #d89b55 100%);
  transition: width 0.3s ease;
}

.progress-fill-0 {
  width: 8%;
}

.progress-fill-1 {
  width: 22%;
}

.progress-fill-2 {
  width: 42%;
}

.progress-fill-3 {
  width: 64%;
}

.progress-fill-4 {
  width: 82%;
}

.progress-fill-5 {
  width: 100%;
}

.progress-steps {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.progress-step {
  color: rgba(255, 244, 220, 0.42);
  font-size: 22rpx;
  font-weight: 800;
}

.progress-step--active {
  color: #ffe3a8;
}

.status-text,
.error-text,
.guide-text {
  margin-top: 20rpx;
  font-size: 25rpx;
  line-height: 1.58;
}

.status-text,
.guide-text {
  color: rgba(255, 244, 220, 0.72);
}

.error-text {
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  color: #fff3e8;
  background: rgba(135, 62, 47, 0.55);
}

.video-card {
  margin-top: 24rpx;
}

.result-video {
  width: 100%;
  height: 420rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #000;
}

.video-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.video-action {
  flex: 1;
}

.video-action--save {
  background: linear-gradient(135deg, #ffe3a8, #d8a24e);
  color: #21170d;
}

.tip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.tip-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: #1f1b14;
  font-size: 22rpx;
  font-weight: 900;
  background: #ffe3a8;
}

.bottom-space {
  height: 76rpx;
}

@keyframes ringFloat {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.55;
  }

  50% {
    transform: scale(1.08);
    opacity: 0.18;
  }
}

@keyframes pulse {
  0%,
  100% {
    transform: scale(1);
  }

  50% {
    transform: scale(0.985);
  }
}
