page {
  background: #f6efe6;
}

.emergency-page {
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 58rpx 32rpx 80rpx;
  color: #281d16;
  background:
    radial-gradient(circle at 86% 0%, rgba(204, 82, 52, 0.16), transparent 34%),
    linear-gradient(180deg, #fff7ed, #efe3d4 56%, #f8f1e8);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-button {
  height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.74);
  color: #6e4632;
  font-size: 25rpx;
  line-height: 58rpx;
  font-weight: 900;
}

.top-title {
  color: rgba(40, 29, 22, 0.7);
  font-size: 25rpx;
  font-weight: 900;
}

.hero {
  margin-top: 28rpx;
  padding: 34rpx;
  border-radius: 12rpx;
  color: #fff8ee;
  background: linear-gradient(135deg, #842a22, #c7643f);
  box-shadow: 0 18rpx 40rpx rgba(132, 42, 34, 0.22);
}

.hero-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 248, 238, 0.18);
  font-size: 31rpx;
  line-height: 96rpx;
  text-align: center;
  font-weight: 900;
  letter-spacing: 0;
}

.hero-title {
  margin-top: 24rpx;
  font-size: 44rpx;
  line-height: 1.18;
  font-weight: 900;
}

.hero-desc {
  margin-top: 14rpx;
  color: rgba(255, 248, 238, 0.78);
  font-size: 25rpx;
  line-height: 1.46;
  font-weight: 800;
}

.location-panel,
.contact-card,
.step-panel,
.help-panel {
  margin-top: 24rpx;
  border-radius: 12rpx;
  background: rgba(255, 252, 246, 0.86);
  box-shadow: 0 12rpx 28rpx rgba(95, 59, 37, 0.1);
}

.location-panel {
  padding: 28rpx;
}

.location-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.location-status {
  color: #ad4f32;
  font-size: 22rpx;
  font-weight: 900;
}

.location-title {
  margin-top: 8rpx;
  color: #281d16;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 900;
}

.refresh-button {
  flex: 0 0 auto;
  height: 54rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(173, 79, 50, 0.12);
  color: #ad4f32;
  font-size: 23rpx;
  line-height: 54rpx;
  font-weight: 900;
}

.location-text {
  margin-top: 18rpx;
  color: rgba(40, 29, 22, 0.66);
  font-size: 24rpx;
  line-height: 1.46;
  font-weight: 800;
}

.action-row {
  display: grid;
  grid-template-columns: 1.12fr 1fr 1fr;
  gap: 12rpx;
  margin-top: 22rpx;
}

.action-button {
  height: 70rpx;
  border-radius: 10rpx;
  background: rgba(127, 84, 52, 0.1);
  color: #68442d;
  font-size: 23rpx;
  line-height: 70rpx;
  text-align: center;
  font-weight: 900;
}

.action-button--dark {
  background: #281d16;
  color: #fff8ee;
}

.section-title {
  margin-top: 34rpx;
  color: #281d16;
  font-size: 35rpx;
  line-height: 1.2;
  font-weight: 900;
}

.contact-list {
  margin-top: 16rpx;
}

.contact-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
}

.contact-title {
  color: #281d16;
  font-size: 29rpx;
  font-weight: 900;
}

.contact-desc {
  margin-top: 8rpx;
  color: rgba(40, 29, 22, 0.58);
  font-size: 23rpx;
  line-height: 1.38;
  font-weight: 800;
}

.phone-pill {
  flex: 0 0 auto;
  min-width: 104rpx;
  height: 62rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #ad4f32;
  color: #fff8ee;
  font-size: 27rpx;
  line-height: 62rpx;
  text-align: center;
  font-weight: 900;
}

.step-panel {
  padding: 8rpx 0;
}

.step-item {
  display: flex;
  padding: 24rpx;
  border-bottom: 2rpx solid rgba(127, 84, 52, 0.08);
}

.step-item:last-child {
  border-bottom: 0;
}

.step-index {
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 54rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: rgba(173, 79, 50, 0.12);
  color: #ad4f32;
  font-size: 24rpx;
  line-height: 54rpx;
  text-align: center;
  font-weight: 900;
}

.step-main {
  flex: 1;
  min-width: 0;
}

.step-title {
  color: #281d16;
  font-size: 28rpx;
  font-weight: 900;
}

.step-desc {
  margin-top: 8rpx;
  color: rgba(40, 29, 22, 0.62);
  font-size: 23rpx;
  line-height: 1.45;
  font-weight: 800;
}

.help-panel {
  padding: 26rpx;
  background: #281d16;
}

.section-title--light {
  margin-top: 0;
  color: #fff8ee;
}

.help-text {
  margin-top: 18rpx;
  color: rgba(255, 248, 238, 0.78);
  font-size: 23rpx;
  line-height: 1.55;
  white-space: pre-wrap;
}

.bottom-space {
  height: 60rpx;
}
