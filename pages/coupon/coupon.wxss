/* pages/index/index.wxss */
.container {
  display: flex;
  flex-direction: column;
  padding: 20px;
  background-color: #f4f4ec;
}

.header {
  display: flex;
  justify-content: center;
  margin-bottom: 20px;
}

.title {
  font-size: 24px;
  font-weight: bold;
}

.search-bar {
  display: flex;
  margin-bottom: 20px;
}

.search-input {
  flex: 1;
  padding: 10px;
  border: 1px solid #ddd;
  border-radius: 5px;
}

.search-button {
  padding: 10px 20px;
  background-color: #e9a91f;
  color: white;
  border: none;
  border-radius: 5px;
}

.filters {
  display: flex;
  margin-bottom: 20px;
}

.filter-item {
  padding: 10px 20px;
  border: 1px solid #ddd;
  margin-right: 10px;
  border-radius: 5px;
}

.filter-item:last-child {
  margin-right: 0;
}

.coupon-list {
  display: flex;
  flex-direction: column;
}

.coupon-item {
  display: flex;
  flex-direction: column;
  border: 1px solid #ddd;
  margin-bottom: 20px;
  padding: 20px;
  border-radius: 5px;
}

.coupon-header {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
}

.coupon-image {
  width: 150px;
  height: 100px;
  margin-right: 20px;
}

.coupon-title {
  font-size: 20px;
  font-weight: bold;
}

.coupon-body {
  margin-bottom: 20px;
}

.coupon-description {
  font-size: 18px;
  color: #666;
  margin-bottom: 10px;
}

.coupon-conditions {
  font-size: 12px;
  color: #999;
  margin-bottom: 10px;
}

.coupon-expiry {
  font-size: 12px;
  color: #999;
}

.coupon-footer {
  display: flex;
  justify-content: flex-end;
}

.coupon-button {
  padding: 10px 20px;
  background-color: #e9a91f;
  color: white;
  border: none;
  border-radius: 5px;
}

.loading {
  display: flex;
  justify-content: center;
  margin-top: 20px;
}