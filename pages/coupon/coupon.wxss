page {
  background: #f4efe4;
}

.coupon-page {
  min-height: 100vh;
  height: 100vh;
  box-sizing: border-box;
  padding: 78rpx 30rpx 50rpx;
  color: #33281d;
  background: linear-gradient(180deg, #f7f1e4, #efe3cf);
}

.hero {
  padding: 36rpx 30rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #7c5a35, #b98a4e);
  color: #fff7e8;
  box-shadow: 0 14rpx 32rpx rgba(82, 66, 41, 0.16);
}

.hero-title {
  font-size: 48rpx;
  font-weight: 900;
}

.hero-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 247, 232, 0.78);
  font-size: 25rpx;
  line-height: 1.45;
}

.filter-scroll {
  margin: 28rpx -30rpx 0;
  white-space: nowrap;
}

.filter-track {
  display: inline-flex;
  padding: 0 30rpx;
}

.filter-chip {
  height: 56rpx;
  margin-right: 14rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 252, 244, 0.82);
  color: #765a36;
  font-size: 24rpx;
  line-height: 56rpx;
  font-weight: 900;
}

.coupon-list {
  margin-top: 24rpx;
}

.coupon-card {
  display: flex;
  align-items: stretch;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: rgba(255, 252, 244, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(82, 66, 41, 0.1);
}

.coupon-card.claimed {
  opacity: 0.68;
}

.coupon-left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  width: 150rpx;
  padding: 24rpx 12rpx;
  background: #7c5a35;
  color: #fff7e8;
  text-align: center;
}

.coupon-amount {
  font-size: 40rpx;
  font-weight: 900;
}

.coupon-condition {
  margin-top: 10rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.coupon-main {
  flex: 1;
  min-width: 0;
  padding: 24rpx 18rpx;
}

.coupon-type {
  color: #9b784c;
  font-size: 21rpx;
  font-weight: 900;
}

.coupon-title {
  margin-top: 8rpx;
  color: #33281d;
  font-size: 30rpx;
  font-weight: 900;
}

.coupon-desc,
.coupon-date {
  margin-top: 8rpx;
  color: rgba(51, 40, 29, 0.62);
  font-size: 22rpx;
  line-height: 1.38;
}

.coupon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  padding: 0 10rpx;
  color: #7c5a35;
  font-size: 22rpx;
  font-weight: 900;
}
