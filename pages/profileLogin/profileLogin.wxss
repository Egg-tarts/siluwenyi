page {
  background: #eee6d7;
}

.login-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #17130f;
}

.login-bg,
.login-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.login-mask {
  background:
    linear-gradient(180deg, rgba(24, 20, 15, 0.22) 0%, rgba(31, 26, 20, 0.1) 36%, rgba(238, 230, 215, 0.94) 100%),
    radial-gradient(circle at 50% 24%, rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0) 34%);
}

.top-bar {
  position: relative;
  z-index: 2;
  padding-top: 76rpx;
  text-align: center;
}

.back-button {
  position: absolute;
  left: 30rpx;
  top: 74rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.68);
  color: #5c452d;
  font-size: 25rpx;
  line-height: 56rpx;
  font-weight: 800;
}

.page-title {
  color: #17130f;
  font-size: 36rpx;
  line-height: 60rpx;
  font-weight: 900;
}

.login-card {
  position: relative;
  z-index: 2;
  width: 686rpx;
  margin: 270rpx auto 0;
  padding: 42rpx 34rpx 36rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 30rpx 70rpx rgba(42, 31, 20, 0.22);
  box-sizing: border-box;
}

.brand {
  color: rgba(37, 30, 22, 0.48);
  font-size: 23rpx;
  text-align: center;
  font-weight: 900;
}

.title {
  margin-top: 8rpx;
  color: #15110e;
  font-size: 50rpx;
  line-height: 1.1;
  text-align: center;
  font-weight: 900;
}

.subtitle {
  width: 540rpx;
  margin: 16rpx auto 0;
  color: rgba(37, 30, 22, 0.58);
  font-size: 25rpx;
  line-height: 1.48;
  text-align: center;
}

.avatar-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 142rpx;
  height: 142rpx;
  margin: 30rpx auto 0;
  padding: 0;
  border-radius: 50%;
  background: #efe7d5;
  overflow: hidden;
}

.avatar-button::after {
  border: 0;
}

.avatar-preview {
  width: 142rpx;
  height: 142rpx;
  border-radius: 50%;
}

.avatar-hint {
  margin-top: 12rpx;
  color: rgba(37, 30, 22, 0.5);
  font-size: 22rpx;
  text-align: center;
  font-weight: 800;
}

.form-input {
  height: 86rpx;
  margin-top: 26rpx;
  padding: 0 26rpx;
  border-radius: 12rpx;
  background: #f4efe6;
  color: #17130f;
  font-size: 28rpx;
  box-sizing: border-box;
}

.phone-auth {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 24rpx 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.08);
}

.phone-left {
  flex: 1;
}

.phone-title {
  color: #17130f;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 900;
}

.phone-desc {
  margin-top: 14rpx;
  color: rgba(27, 27, 27, 0.42);
  font-size: 26rpx;
}

.phone-check {
  width: 58rpx;
  height: 58rpx;
  color: #18b521;
  font-size: 46rpx;
  line-height: 58rpx;
  text-align: center;
  font-weight: 900;
}

.phone-check-on {
  color: #18b521;
}

.status-line {
  display: flex;
  align-items: flex-start;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #f4efe6;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  margin: 10rpx 16rpx 0 0;
  border-radius: 50%;
  background: #19b321;
  box-shadow: 0 0 18rpx rgba(25, 179, 33, 0.42);
}

.status-main {
  flex: 1;
  min-width: 0;
}

.status-step {
  color: #17130f;
  font-size: 24rpx;
  font-weight: 900;
}

.status-text {
  margin-top: 6rpx;
  color: rgba(37, 30, 22, 0.58);
  font-size: 22rpx;
  line-height: 1.36;
}

.primary-button {
  height: 88rpx;
  margin-top: 30rpx;
  border-radius: 10rpx;
  background: #16b51f;
  color: #fff;
  font-size: 30rpx;
  line-height: 88rpx;
  font-weight: 900;
}

.primary-button[disabled] {
  background: #d9d9d9;
  color: rgba(0, 0, 0, 0.4);
}

.guest-button {
  height: 82rpx;
  margin-top: 18rpx;
  border-radius: 10rpx;
  background: rgba(47, 36, 25, 0.08);
  color: #2f2419;
  font-size: 29rpx;
  line-height: 82rpx;
  font-weight: 900;
}

.guest-button::after {
  border: 0;
}

.guest-button[disabled] {
  color: rgba(47, 36, 25, 0.42);
  background: rgba(47, 36, 25, 0.05);
}

.guest-note {
  width: 560rpx;
  margin: 14rpx auto 0;
  color: rgba(37, 30, 22, 0.46);
  font-size: 22rpx;
  line-height: 1.46;
  text-align: center;
}

.manual-link {
  margin-top: 28rpx;
  color: #53647d;
  font-size: 27rpx;
  font-weight: 800;
}

.manual-box {
  margin-top: 18rpx;
  padding-top: 2rpx;
}

.manual-input {
  margin-top: 0;
}

.manual-button {
  height: 78rpx;
  margin-top: 18rpx;
  border-radius: 10rpx;
  background: #2f2419;
  color: #fff7e8;
  font-size: 27rpx;
  line-height: 78rpx;
  font-weight: 900;
}
