page {
  background: #efe3cf;
}

.page {
  min-height: 100vh;
  height: 100vh;
  padding: 76rpx 30rpx 58rpx;
  box-sizing: border-box;
  color: #3f3326;
  background: linear-gradient(180deg, #fbf3e4 0%, #ead7bc 58%, #dfc39d 100%);
}

.back-button {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  padding: 0 22rpx;
  margin-bottom: 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 250, 239, 0.88);
  color: #6b5537;
  font-size: 25rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 18rpx rgba(82, 55, 25, 0.1);
}

.hero {
  padding: 38rpx 34rpx;
  border-radius: 8rpx;
  background:
    linear-gradient(135deg, rgba(78, 56, 34, 0.94), rgba(154, 107, 55, 0.82)),
    url("https://free.picui.cn/free/2026/06/21/6a376644b3b26.png");
  background-size: cover;
  background-position: center;
  box-shadow: 0 18rpx 40rpx rgba(82, 55, 25, 0.18);
}

.eyebrow {
  color: rgba(255, 231, 190, 0.84);
  font-size: 22rpx;
  font-weight: 800;
}

.title {
  margin-top: 12rpx;
  color: #fff4dd;
  font-size: 62rpx;
  line-height: 1.04;
  font-weight: 900;
}

.subtitle {
  margin-top: 16rpx;
  color: rgba(255, 244, 221, 0.84);
  font-size: 27rpx;
  line-height: 1.55;
}

.hero-button {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fff4dd;
  color: #5c482d;
  font-size: 24rpx;
  font-weight: 900;
}

.comfort-panel,
.plan-card,
.module {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: rgba(255, 251, 243, 0.92);
  box-shadow: 0 14rpx 30rpx rgba(82, 55, 25, 0.14);
}

.comfort-title {
  color: #9f7441;
  font-size: 24rpx;
  font-weight: 900;
}

.comfort-score {
  margin-top: 8rpx;
  color: #3f3326;
  font-size: 40rpx;
  line-height: 1.18;
  font-weight: 900;
}

.comfort-desc,
.plan-text {
  margin-top: 12rpx;
  color: rgba(63, 51, 38, 0.68);
  font-size: 25rpx;
  line-height: 1.48;
}

.comfort-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.comfort-item {
  padding: 16rpx 12rpx;
  border-radius: 8rpx;
  background: #f1e1c7;
  text-align: center;
}

.comfort-label,
.comfort-value {
  display: block;
}

.comfort-label {
  color: rgba(63, 51, 38, 0.58);
  font-size: 21rpx;
  font-weight: 800;
}

.comfort-value {
  margin-top: 6rpx;
  color: #5c482d;
  font-size: 27rpx;
  font-weight: 900;
}

.station-strip {
  margin: 28rpx -30rpx 0;
  white-space: nowrap;
}

.station-track {
  display: inline-flex;
  padding: 0 30rpx;
}

.station-chip {
  height: 62rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 251, 243, 0.86);
  color: #7c603a;
  font-size: 24rpx;
  line-height: 62rpx;
  font-weight: 900;
}

.station-chip-active {
  background: #5c482d;
  color: #fff4dd;
}

.current-card {
  margin-top: 22rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: rgba(255, 251, 243, 0.92);
  box-shadow: 0 14rpx 30rpx rgba(82, 55, 25, 0.14);
}

.current-image {
  width: 100%;
  height: 350rpx;
}

.current-info {
  padding: 24rpx;
}

.current-meta {
  color: #9f7441;
  font-size: 22rpx;
  font-weight: 900;
}

.current-title,
.section-title {
  margin-top: 8rpx;
  color: #3f3326;
  font-size: 36rpx;
  font-weight: 900;
}

.current-desc {
  margin-top: 12rpx;
  color: rgba(63, 51, 38, 0.68);
  font-size: 25rpx;
  line-height: 1.48;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag {
  margin: 0 10rpx 10rpx 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(158, 118, 65, 0.14);
  color: #8b673a;
  font-size: 22rpx;
  font-weight: 800;
}

.service-item {
  display: flex;
  margin-top: 16rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: rgba(255, 251, 243, 0.9);
  box-shadow: 0 10rpx 24rpx rgba(75, 52, 26, 0.08);
}

.service-index {
  flex: 0 0 62rpx;
  color: #9f7441;
  font-size: 25rpx;
  font-weight: 900;
}

.service-title,
.nanny-title {
  color: #3f3326;
  font-size: 29rpx;
  font-weight: 900;
}

.service-desc,
.nanny-desc {
  margin-top: 8rpx;
  color: rgba(63, 51, 38, 0.66);
  font-size: 24rpx;
  line-height: 1.45;
}

.module-title {
  margin-top: 0;
}

.todo {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(107, 85, 55, 0.1);
}

.todo:last-child {
  border-bottom: 0;
}

.todo-dot {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #e7d6ba;
  color: #fff;
  line-height: 44rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 900;
}

.todo.done .todo-dot {
  background: #6b5537;
}

.todo-text {
  flex: 1;
  color: #3f3326;
  font-size: 25rpx;
  font-weight: 800;
}

.nanny-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin: 24rpx 0 40rpx;
}

.nanny-card {
  min-height: 190rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: rgba(255, 251, 243, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(75, 52, 26, 0.08);
}
