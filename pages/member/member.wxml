<view class="container">
  <!-- 用户信息区域 -->
  <view class="user-info">
    <!-- 为头像图片绑定点击事件 -->
    <image class="avatar" src="{{avatarUrl}}||'/pages/graph/灰色微信头像.webp'" bindtap="handleAvatarClick"></image>
    <view class="user-details">
      <text class="username">{{name}}||用户名</text>
      <view class="level-progress">
        <text class="level">Lv.--</text> <!-- 等级暂不显示 -->
        <view class="progress-bar">
          <view class="progress" style="width: 0%;"></view> <!-- 进度条宽度为 0% -->
        </view>
        <text class="progress-text">0/200</text> <!-- 显示进度为 0/200 -->
      </view>
    </view>
  </view>

  <!-- 灰色实线 -->
  <view class="divider"></view>

  <!-- 三个模块：我的积分，优惠券，购物车 -->
  <view class="module-row">
    <view class="module-item">
      <image class="module-icon" src="http://sk0jj0v9g.hn-bkt.clouddn.com/BOTZDIGXXEOP91%2489OPT8JF.png"></image>
    </view>
    <view class="module-item">
      <image class="module-icon" src="http://sk0jj0v9g.hn-bkt.clouddn.com/XLS6A85%29GDBAUE%25M~%40%5D1AO0.png"></image>
    </view>
    <view class="module-item">
      <image class="module-icon" src="http://sk0jj0v9g.hn-bkt.clouddn.com/DF~P%5B1G%28_G4%24FJRVRALB_VT.png"></image>
    </view>
  </view>

  <!-- 两个竖着的模块，宽度改为全宽 -->
  <view class="vertical-module">
    <view class="vertical-item">
      <text class="vertical-text">个人信息</text>
      <image class="vertical-icon" src="http://sk0jj0v9g.hn-bkt.clouddn.com/04b659460d8f992fb2b65f10e382b379.jpg"></image>
    </view>
    <view class="vertical-item">
      <text class="vertical-text">联系我们</text>
      <image class="vertical-icon" src="http://sk0jj0v9g.hn-bkt.clouddn.com/04b659460d8f992fb2b65f10e382b379.jpg"></image>
    </view>
  </view>

  <!-- 四个景点介绍 -->
  <view class="spot-grid">
    <view class="spot-item">
      <image class="spot-image" src="http://sk0jj0v9g.hn-bkt.clouddn.com/OIP.jpg"></image>
      <text class="spot-text">敦煌-莫高窟</text>
    </view>
    <view class="spot-item">
      <image class="spot-image" src="http://sk0jj0v9g.hn-bkt.clouddn.com/R.png"></image>
      <text class="spot-text">天水-麦积山</text>
    </view>
    <view class="spot-item">
      <image class="spot-image" src="http://sk0jj0v9g.hn-bkt.clouddn.com/R.jpg"></image>
      <text class="spot-text">张掖-七彩丹霞</text>
    </view>
    <view class="spot-item">
      <image class="spot-image" src="http://sk0jj0v9g.hn-bkt.clouddn.com/OIP%20%281%29.jpg"></image>
      <text class="spot-text">兰州-白塔山</text>
    </view>
  </view>
</view>
