/* 页面容器 */
/* 页面容器 */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  margin: 0;
  background-color: #f4f4ec;
}

/* 顶部区域 */
.top-section {
  display: flex;
  width: 100%;
  padding: 10px;
  background-color: #f4f4ec;
  position: relative;
}

.top-icon {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 40px;
  height: 40px;
  margin-right: 10px;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 5px;
}

.avatar {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  margin-bottom: 5px;
}

.other-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 0;
}

.name-level {
  display: flex;
  align-items: center;
}

.user-name {
  font-size: 25px;
  font-weight: bold;
  margin-right: 10px;
  margin-bottom: 6px; 
}

.user-level {
  font-size: 14px;
  color: #888;
}

.user-points {
  font-size: 14px;
  color: #888;
  margin-top: 5px;
}

.chuyou-text {
  width: 100%;
  text-align: left;
  font-size: 25px;
  margin: 5px 0;
  padding-left: 10px;
}

.rectangle-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 10px;
}

.rectangle {
  display: flex;
  align-items: center;
  padding: 10px;
  margin-bottom: 10px; 
  background-color: #f4f4ec;
  border: 1px solid #ddd;
  border-radius: 10px;
  box-shadow: 4px 5px 10px rgba(0, 0, 0, 0.1);
  width: 90%;
}

.rectangle-icon {
  width: 30px;
  height: 30px;
  margin-right: 10px;
}

.rectangle-text {
  font-size: 20px;
  margin-left: 10px;
}

.modal-container {
  display: flex;
  justify-content: center;
  align-items: center;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.modal {
  background-color: white;
  padding: 20px;
  border-radius: 15px;
  width: 80%;
  max-width: 500px;
}

.modal-header {
  font-size: 20px;
  margin-bottom: 15px;
  font-weight: bold;
  margin-left: 100px;
}

.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 15px;
}

.icon {
  width: 35px;
  height: 35px;
  margin-right: 10px;
}

.input-line {
  flex: 1;
  border: none;
  border-bottom: 2px solid #ddd;
  padding: 10px 5px;
  font-size: 16px;
}

.upload-button {
  margin-top: 10px;
  margin-left: 30px;
}

.avatar-preview {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  margin-top: 10px;
}

.form-footer {
  display: flex;
  justify-content: space-between;
}

.submit-button,
.cancel-button {
  padding: 10px 20px;
  border-radius: 5px;
  font-size: 16px;
}

.submit-button {
  background-color: #6e6e58;
  color: white;
  border: none;
  width: 30%;
}

.cancel-button {
  background-color: #f4f4ec;
  color: #333;
  border: none;
  width: 30%;
}

