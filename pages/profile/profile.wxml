<view class="container">
  <!-- 顶部区域 -->
  <view class="top-section">
    <image class="top-icon" src="/pages/graph/右上.png" />
    <view class="avatar-section" bindtap="goToRegisterPage">
      <image class="avatar" src="{{avatarUrl || '/pages/graph/灰色微信头像.webp'}}" />
    </view>
    <view class="other-content">
      <view class="name-level">
        <text class="user-name">{{name || '点击登录'}}</text>
        <text class="user-level">Lv-</text>
      </view>
      <text class="user-points">积分:-</text>
    </view>
  </view>

  <text class="chuyou-text">出游</text>

  <view class="rectangle-section">
    <view class="rectangle" bindtap='navigateToMember'>
      <image class="rectangle-icon" src="/pages/graph/会员.png" />
      <text class="rectangle-text">会员</text>
    </view>
    <view class="rectangle" bindtap="navigateToOrders">
      <image class="rectangle-icon" src="/pages/graph/我的订单.png" />
      <text class="rectangle-text">我的订单</text>
    </view>
    <view class="rectangle" bindtap='navigateToHistoryBrowse'>
      <image class="rectangle-icon" src="/pages/graph/历史行程.png" />
      <text class="rectangle-text">历史行程</text>
    </view>
    <view class="rectangle" bindtap='navigateToCategory'>
      <image class="rectangle-icon" src="/pages/graph/购物车.png" />
      <text class="rectangle-text">购物车</text>
    </view>
  </view>

  <text class="chuyou-text">社区</text>
  <view class="rectangle-section"> 
    <view class="rectangle" bindtap="navigateToHistory">
      <image class="rectangle-icon" src="/pages/graph/浏览历史.png" />
      <text class="rectangle-text">浏览历史</text>
    </view>
    <view class="rectangle" bindtap="navigateToLikes">
      <image class="rectangle-icon" src="/pages/graph/收藏.png" />
      <text class="rectangle-text">我的点赞</text>
    </view>
    <view class="rectangle" bindtap="navigateToPosts">
      <image class="rectangle-icon" src="/pages/graph/发布.png" />
      <text class="rectangle-text">我的发布</text>
    </view>
  </view>
</view>
