<view class="container">
  <!-- 顶部区域 -->
  <view class="top-section">
    <image class="top-icon" src="/pages/graph/右上.png" />
    <view class="avatar-section" bindtap="goToLoginPage">
      <image class="avatar" src="/pages/graph/头像.jpg" />
    </view>
    <view class="other-content">
      <view class="name-level">
        <text class="user-name">我是科比</text>
        <text class="user-level">Lv3</text>
      </view>
      <text class="user-points">积分:520</text>
    </view>
  </view>

  <text class="chuyou-text">出游</text>

  <view class="rectangle-section">
    <view class="rectangle">
      <image class="rectangle-icon" src="/pages/graph/会员.png" />
      <text class="rectangle-text">会员</text>
    </view>
    <view class="rectangle">
      <image class="rectangle-icon" src="/pages/graph/我的订单.png" />
      <text class="rectangle-text">我的订单</text>
    </view>
    <view class="rectangle">
      <image class="rectangle-icon" src="/pages/graph/历史行程.png" />
      <text class="rectangle-text">历史行程</text>
    </view>
    <view class="rectangle">
      <image class="rectangle-icon" src="/pages/graph/购物车.png" />
      <text class="rectangle-text">购物车</text>
    </view>
  </view>

  <text class="chuyou-text">社区</text>
  <view class="rectangle-section"> 
    <view class="rectangle">
      <image class="rectangle-icon" src="/pages/graph/浏览历史.png" />
      <text class="rectangle-text">浏览历史</text>
    </view>
    <view class="rectangle">
      <image class="rectangle-icon" src="/pages/graph/收藏.png" />
      <text class="rectangle-text">我的点赞</text>
    </view>
    <view class="rectangle">
      <image class="rectangle-icon" src="/pages/graph/发布.png" />
      <text class="rectangle-text">我的发布</text>
    </view>
  </view>
  <view class="modal-container" wx:if="{{showModal}}">
    <view class="modal">
      <view class="modal-header">注册新用户</view>
      <form bindsubmit="handleSubmit">
        <view class="form-item">
          <text>头像</text>
          <button class="upload-button" bindtap="chooseAvatar">选择头像</button>
          <image class="avatar-preview" src="{{avatar}}" wx:if="{{avatar}}" />
        </view>
        <view class="form-item">
          <text>昵称</text>
          <input class="input" type="text" placeholder="请输入昵称" value="{{nickname}}" bindinput="handleNicknameInput" />
        </view>
        <view class="form-item">
          <text>电话号码</text>
          <input class="input" type="number" placeholder="请输入电话号码" value="{{phone}}" bindinput="handlePhoneInput" />
        </view>
        <view class="form-footer">
          <button formType="submit" class="submit-button">提交</button>
          <button class="cancel-button" bindtap="hideModal">取消</button>
        </view>
      </form>
    </view>
  </view>
</view>
