page {
  background: #f5eddc;
}

.community-page {
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 70rpx 26rpx 150rpx;
  color: #33281d;
  background:
    linear-gradient(180deg, rgba(250, 242, 226, 0.96), rgba(238, 218, 184, 0.94)),
    url("https://free.picui.cn/free/2026/06/21/6a377a096c7f3.png");
  background-size: cover;
  background-position: center top;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
}

.back,
.top-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 252, 244, 0.74);
  color: #6c5437;
  font-size: 46rpx;
  line-height: 52rpx;
  text-align: center;
  font-weight: 700;
}

.top-dot {
  background: transparent;
}

.top-title {
  color: #33281d;
  font-size: 36rpx;
  font-weight: 900;
}

.question-bar,
.search-card,
.block-panel,
.note-card,
.end-card {
  background: rgba(255, 252, 244, 0.9);
  box-shadow: 0 10rpx 24rpx rgba(91, 64, 31, 0.09);
}

.question-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 8rpx;
}

.question-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #7c5a35;
  color: #fff7e8;
  font-size: 22rpx;
  font-weight: 900;
}

.avatar {
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  border-radius: 50%;
  background: #e8d8bd;
}

.question-text {
  flex: 1;
  min-width: 0;
  color: #3c2d1e;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 800;
}

.question-arrow {
  color: #8c6d46;
  font-size: 42rpx;
  line-height: 1;
}

.search-card {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin-top: 20rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
}

.search-icon {
  color: #9b784c;
  font-size: 34rpx;
  font-weight: 900;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding-left: 14rpx;
  color: #33281d;
  font-size: 25rpx;
}

.ar-entry-card {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 214rpx;
  margin-top: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 8rpx;
  background:
    linear-gradient(135deg, rgba(32, 42, 35, 0.96), rgba(127, 87, 42, 0.86)),
    url("https://free.picui.cn/free/2026/06/21/6a376644b3b26.png");
  background-size: cover;
  background-position: center;
  box-shadow: 0 16rpx 34rpx rgba(91, 64, 31, 0.16);
}

.ar-entry-card::after {
  content: "";
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 22rpx;
  height: 2rpx;
  background: rgba(255, 232, 174, 0.32);
}

.ar-entry-main {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.ar-entry-kicker {
  color: rgba(255, 232, 174, 0.82);
  font-size: 22rpx;
  font-weight: 900;
}

.ar-entry-title {
  margin-top: 10rpx;
  color: #fff7e8;
  font-size: 38rpx;
  line-height: 1.16;
  font-weight: 900;
}

.ar-entry-desc {
  width: 420rpx;
  margin-top: 12rpx;
  color: rgba(255, 247, 232, 0.74);
  font-size: 23rpx;
  line-height: 1.45;
}

.ar-entry-visual {
  position: relative;
  z-index: 2;
  width: 142rpx;
  height: 142rpx;
}

.ar-ring,
.ar-lens {
  position: absolute;
  border-radius: 50%;
}

.ar-ring {
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border: 2rpx solid rgba(255, 232, 174, 0.42);
  animation: arRing 2.2s ease-out infinite;
}

.ar-lens {
  top: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  color: #2b2116;
  font-size: 34rpx;
  line-height: 94rpx;
  text-align: center;
  font-weight: 900;
  background: #ffe3a8;
}

.topic-scroll,
.quick-scroll,
.partner-scroll {
  margin: 26rpx -26rpx 0;
  white-space: nowrap;
}

.topic-track,
.quick-track,
.partner-track {
  display: inline-flex;
  padding: 0 26rpx;
}

.topic-card {
  position: relative;
  width: 430rpx;
  height: 218rpx;
  margin-right: 18rpx;
  overflow: hidden;
  border-radius: 8rpx;
  box-shadow: 0 14rpx 32rpx rgba(91, 64, 31, 0.14);
}

.topic-image,
.topic-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.topic-mask {
  background: linear-gradient(135deg, rgba(52, 38, 25, 0.86), rgba(99, 72, 42, 0.34));
}

.topic-content {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  color: #fff7e8;
}

.topic-title {
  font-size: 30rpx;
  font-weight: 900;
}

.topic-desc {
  width: 330rpx;
  margin-top: 10rpx;
  color: rgba(255, 247, 232, 0.78);
  font-size: 22rpx;
  line-height: 1.42;
  white-space: normal;
}

.topic-count {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 247, 232, 0.16);
  font-size: 20rpx;
  font-weight: 900;
}

.quick-chip {
  height: 56rpx;
  padding: 0 24rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 252, 244, 0.84);
  color: #765a36;
  font-size: 23rpx;
  line-height: 56rpx;
  font-weight: 900;
}

.block-panel {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 8rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
}

.section-head.compact {
  margin-top: 0;
}

.section-title {
  color: #33281d;
  font-size: 38rpx;
  font-weight: 900;
}

.section-more {
  color: #8c6d46;
  font-size: 24rpx;
  font-weight: 900;
}

.discuss-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(124, 90, 53, 0.1);
}

.discuss-item:last-child {
  border-bottom: 0;
}

.discuss-heat {
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #7c5a35;
  color: #fff7e8;
  font-size: 20rpx;
  line-height: 48rpx;
  text-align: center;
  font-weight: 900;
}

.discuss-title {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
  color: #3c2d1e;
  font-size: 25rpx;
  line-height: 1.36;
  font-weight: 900;
}

.discuss-reply {
  color: rgba(51, 40, 29, 0.52);
  font-size: 20rpx;
  font-weight: 800;
}

.partner-card {
  width: 230rpx;
  min-height: 150rpx;
  margin-right: 16rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: rgba(255, 252, 244, 0.88);
  box-shadow: 0 10rpx 24rpx rgba(91, 64, 31, 0.08);
}

.partner-city {
  color: #33281d;
  font-size: 34rpx;
  font-weight: 900;
}

.partner-text {
  margin-top: 10rpx;
  color: rgba(51, 40, 29, 0.66);
  font-size: 22rpx;
  line-height: 1.42;
  white-space: normal;
}

.partner-people {
  margin-top: 14rpx;
  color: #8c6d46;
  font-size: 20rpx;
  font-weight: 900;
}

.masonry {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
}

.column {
  flex: 1;
  min-width: 0;
}

.note-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 18rpx;
  border-radius: 8rpx;
}

.note-image {
  width: 100%;
  min-height: 220rpx;
  display: block;
}

.play-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.42);
  color: #fff;
  font-size: 22rpx;
  line-height: 48rpx;
  text-align: center;
}

.note-body {
  padding: 18rpx;
}

.note-tag {
  display: inline-flex;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #efe0c4;
  color: #856239;
  font-size: 19rpx;
  font-weight: 900;
}

.note-title {
  margin-top: 10rpx;
  color: #33281d;
  font-size: 28rpx;
  line-height: 1.28;
  font-weight: 900;
}

.note-desc {
  margin-top: 8rpx;
  color: rgba(51, 40, 29, 0.64);
  font-size: 22rpx;
  line-height: 1.42;
}

.note-footer {
  margin-top: 16rpx;
}

.author {
  display: flex;
  align-items: center;
}

.author-name {
  flex: 1;
  min-width: 0;
  margin-left: 10rpx;
  color: #5d4630;
  font-size: 21rpx;
  font-weight: 900;
}

.metrics {
  margin-top: 8rpx;
  color: rgba(51, 40, 29, 0.52);
  font-size: 20rpx;
  font-weight: 800;
}

.end-card {
  margin-top: 26rpx;
  padding: 34rpx 28rpx;
  border-radius: 8rpx;
  text-align: center;
}

.end-title {
  color: #7c5a35;
  font-size: 34rpx;
  font-weight: 900;
}

.end-text {
  margin-top: 12rpx;
  color: rgba(51, 40, 29, 0.58);
  font-size: 24rpx;
  line-height: 1.45;
}

.publish-button {
  position: fixed;
  right: 34rpx;
  bottom: 166rpx;
  z-index: 20;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #7c5a35;
  color: #fff7e8;
  font-size: 54rpx;
  line-height: 88rpx;
  text-align: center;
  box-shadow: 0 14rpx 30rpx rgba(91, 64, 31, 0.24);
}

.bottom-space {
  height: 60rpx;
}

.detail-page {
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 70rpx 26rpx 70rpx;
  color: #33281d;
  background:
    linear-gradient(180deg, rgba(250, 242, 226, 0.96), rgba(238, 218, 184, 0.94)),
    url("https://free.picui.cn/free/2026/06/21/6a377a096c7f3.png");
  background-size: cover;
  background-position: center top;
}

.detail-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 66rpx;
}

.detail-back,
.detail-more {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 252, 244, 0.78);
  color: #6c5437;
  font-size: 24rpx;
  font-weight: 900;
}

.detail-image {
  width: 100%;
  height: 460rpx;
  margin-top: 20rpx;
  border-radius: 8rpx;
  box-shadow: 0 14rpx 32rpx rgba(91, 64, 31, 0.14);
}

.detail-card,
.comment-panel,
.comment-focus,
.related-card {
  background: rgba(255, 252, 244, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(91, 64, 31, 0.09);
}

.detail-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 8rpx;
}

.detail-author {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar.big {
  width: 62rpx;
  height: 62rpx;
  flex-basis: 62rpx;
}

.author-title {
  color: #33281d;
  font-size: 27rpx;
  font-weight: 900;
}

.author-sub {
  margin-top: 6rpx;
  color: rgba(51, 40, 29, 0.52);
  font-size: 21rpx;
  font-weight: 800;
}

.detail-title {
  margin-top: 28rpx;
  color: #33281d;
  font-size: 42rpx;
  line-height: 1.22;
  font-weight: 900;
}

.detail-body {
  margin-top: 18rpx;
  color: rgba(51, 40, 29, 0.76);
  font-size: 27rpx;
  line-height: 1.65;
}

.detail-meta {
  margin-top: 22rpx;
  color: #8c6d46;
  font-size: 23rpx;
  font-weight: 900;
}

.detail-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.detail-action {
  flex: 1;
  height: 58rpx;
  border-radius: 8rpx;
  background: rgba(239, 224, 196, 0.68);
  color: #6c4d2e;
  font-size: 23rpx;
  line-height: 58rpx;
  text-align: center;
  font-weight: 900;
}

.detail-action--active {
  background: #7c5a35;
  color: #fff7e8;
}

.detail-action--ar {
  background: #265653;
  color: #fff7e8;
}

.comment-panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 8rpx;
}

.comment-item {
  display: flex;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid rgba(124, 90, 53, 0.1);
}

.comment-item:last-child {
  border-bottom: 0;
}

.comment-main {
  flex: 1;
  min-width: 0;
}

.comment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comment-name {
  color: #33281d;
  font-size: 25rpx;
  font-weight: 900;
}

.comment-like {
  color: rgba(51, 40, 29, 0.48);
  font-size: 20rpx;
  font-weight: 800;
}

.comment-like--active {
  color: #7c5a35;
}

.comment-text {
  margin-top: 8rpx;
  color: rgba(51, 40, 29, 0.72);
  font-size: 24rpx;
  line-height: 1.48;
}

.comment-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 12rpx;
}

.comment-mini-action {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: rgba(239, 224, 196, 0.56);
  color: #7c5a35;
  font-size: 21rpx;
  font-weight: 900;
}

.reply-item {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(239, 224, 196, 0.58);
  color: rgba(51, 40, 29, 0.66);
  font-size: 22rpx;
  line-height: 1.42;
}

.comment-focus {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 8rpx;
}

.focus-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 18rpx;
}

.focus-name {
  color: #33281d;
  font-size: 26rpx;
  font-weight: 900;
}

.focus-text {
  margin-top: 16rpx;
  color: rgba(51, 40, 29, 0.74);
  font-size: 25rpx;
  line-height: 1.5;
}

.focus-reply {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(239, 224, 196, 0.62);
  color: rgba(51, 40, 29, 0.66);
  font-size: 23rpx;
  line-height: 1.45;
}

.related-list {
  margin-top: 18rpx;
}

.related-card {
  display: flex;
  margin-bottom: 18rpx;
  padding: 18rpx;
  border-radius: 8rpx;
}

.related-image {
  width: 180rpx;
  height: 168rpx;
  border-radius: 8rpx;
}

.related-info {
  flex: 1;
  min-width: 0;
  padding-left: 18rpx;
}

.related-title {
  margin-top: 10rpx;
  color: #33281d;
  font-size: 29rpx;
  font-weight: 900;
}

.related-desc {
  margin-top: 8rpx;
  color: rgba(51, 40, 29, 0.62);
  font-size: 22rpx;
  line-height: 1.42;
}

@keyframes arRing {
  from {
    opacity: 0.9;
    transform: scale(0.84);
  }

  to {
    opacity: 0;
    transform: scale(1.18);
  }
}
