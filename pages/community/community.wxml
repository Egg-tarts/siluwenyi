<view class="container" >
  <view class="search-container">
    <!-- 搜索框 -->
    <input class="search-input" bindinput="onInput"  bindconfirm="searchFunc"  />
  <image class="search-icon" src="/pages/images/search.png" wx:if="{{showIcon}}" />
    <!-- 显示信息的按钮 -->
    <view class="info-button">
      <button open-type="contact" bindcontact="handleContact" type="primary"class="custom-button" style="width: 164rpx; height: 80rpx; display: block; box-sizing: border-box; left: -36rpx; top: -15rpx; position: absolute">
    <cover-image src="/pages/images/talk.png" class="button-image-1"></cover-image>
</button>
</view>
  </view>
  <view class="button-group">
    <view 
      class="button {{currentTab === 'scenic' ? 'active' : ''}}" 
      data-type="scenic"
      bindtap="handleButtonClick"
    ><span class="text">景点</span></view>
    <view 
      class="button {{currentTab === 'city' ? 'active' : ''}}" 
      data-type="city"
      bindtap="handleButtonClick"
    ><span class="text">推荐</span></view>
  </view>

  <view  wx:if="{{currentTab === 'scenic'}}" class="scroll-view" scroll-y="true" >
    <view class="button-grid-left">
      <block wx:for="{{buttonListleft}}" wx:key="index">
        <view class="button_url_left" data-id="{{item.id}}" bindtap="handleButtonClickUrl">
          <image class="button-image" src="https://lzuer.mynatapp.cc{{item.images[0]}}" mode="widthFix"></image>
          <view class="button-text-big">{{item.text_big}}</view>
          <view class="button-text-normal">{{item.text_normal}}</view>
          <view class="stars">
    <image class="star" src="/pages/images/star.png"></image>
    <image class="star" src="/pages/images/star.png"></image>
    <image class="star" src="/pages/images/star.png"></image>
    <image class="star" src="/pages/images/star.png"></image>
    <image class="star" src="/pages/images/star.png"></image>
          </view>      
          <view class="button-text-popular-money">
          <view class="button-text-popular">{{popular}}</view>
          <view class="button-text-money">{{item.money}}</view>
        </view>
      </view>
      </block>
      </view>
      <view class="button-grid-right">
      <block wx:for="{{buttonListright}}" wx:key="index">
        <view class="button_url_right" data-id="{{item.id}}" bindtap="handleButtonClickUrl">
          <image class="button-image" src="https://lzuer.mynatapp.cc{{item.images[0]}}" mode="widthFix" ></image>
          <view class="button-text-big">{{item.text_big}}</view>
          <view class="button-text-normal">{{item.text_normal}}</view>
          <view class="stars">
    <image class="star" src="/pages/images/star.png"></image>
    <image class="star" src="/pages/images/star.png"></image>
    <image class="star" src="/pages/images/star.png"></image>
    <image class="star" src="/pages/images/star.png"></image>
    <image class="star" src="/pages/images/star.png"></image>
          </view>      
          <view class="button-text-popular-money">
          <view class="button-text-popular">{{popular}}</view>
          <view class="button-text-money">{{item.money}}</view>
        </view>
      </view>
      </block>
    </view>
  </view>
  <view  wx:if="{{currentTab === 'city'}}" class="scroll-view" scroll-y="true" >
    <view class="floating-button" bindtap="navigateToMyRecommend">
    <text class="plus-sign">+</text></view>

    <view class="button-grid-left">
  <block wx:for="{{buttonListleft_recommend}}" wx:key="index">
    <view class="button_url_left" data-id="{{item.id}}" bindtap="handleButtonClickUrl">
      <image class="button-image" src="https://lzuer.mynatapp.cc{{item.images[0]}}" mode="widthFix"></image>
      <view class="button_head_txt">{{item.head_txt}}</view>
      <view class="author-info">
        <view class="author-avatar">
          <image class="avatar" src="https://lzuer.mynatapp.cc{{item.author.avatar}}" mode="aspectFill"></image>
        </view>
        <view class="author-name">{{item.author.username}}</view>
        <view class="like">{{item.likes_count}}点赞</view>
      </view>
    </view>
  </block>
</view>
<view class="button-grid-right">
  <block wx:for="{{buttonListright_recommend}}" wx:key="index">
    <view class="button_url_right" data-id="{{item.id}}" bindtap="handleButtonClickUrl">
      <image class="button-image" src="https://lzuer.mynatapp.cc{{item.images[0]}}" mode="widthFix"></image>
      <view class="button_head_txt">{{item.head_txt}}</view>
      <view class="author-info">
        <view class="author-avatar">
          <image class="avatar" src="https://lzuer.mynatapp.cc{{item.author.avatar}}" mode="aspectFill"></image>
        </view>
        <view class="author-name">{{item.author.username}}</view>
        <view class="like">{{item.likes_count}}点赞</view>
      </view>
    </view>
  </block>
</view>
</view>
</view>
<tabbar></tabbar>