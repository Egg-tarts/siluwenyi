.container {
  padding: 10rpx;
  background-color: #f4f4ec;
}

.back-button {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  font-size: 20rpx;
}

.swiper-container {
  width: 100%;
  height: 1000rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.title {
  margin-top: 100rpx;
}
.comments-section {
  margin-top: 20rpx; /* 为标题与正文之间添加一些间距 */
}

.comments-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10px;
  border-top: 1px solid #ddd; /* 给评论区标题添加顶部边框 */
  padding-top: 30px;
  padding-right: 560rpx; /* 确保标题靠左对齐 */
  color:	#727272;
}
.text-big {
  font-size: 40rpx;
  font-weight: bold;
}

.content {
  margin-top: 10rpx;

}

.comments {
  margin-top: 0rpx;
  border-top: 1px solid #ddd; /* 给评论区添加顶部边框 */
  margin-bottom: 150rpx;
}

.comment-item {
  padding-bottom: 30rpx; /* 增加与border-bottom的距离 */
  display: flex;
  align-items: flex-start;
  margin-top: 30rpx;
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid #ddd; /* 在每个评论项下方添加边框 */
}

.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: #e6d8c0;
}

.comment-content {
  margin-left: 20rpx; /* 向右移动 */
  display: flex;
  flex-direction: column;

}

.name {

  position: relative;
  top: -2rpx; /* 向上移动 */
  color:	#8f8f8f;
  font-size: 27rpx;
  font-weight: bold;
}

.comment {
  margin-top: 5rpx;
}

.comment-actions {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.comment-action {
  margin-right: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  color: #7a5734;
  font-size: 22rpx;
  background: rgba(232, 216, 192, 0.78);
}

.reply-list {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.62);
}

.reply-item {
  color: #66513a;
  font-size: 23rpx;
  line-height: 1.45;
}
.comment-container {
  height: 100rpx;
  position: fixed;
  bottom: 0;
  width: 100%;
  display: flex;
  align-items: center;
  background-color: #f4f4ec;
  padding: 10px;
  box-shadow: 0 -1px 5px rgba(0,0,0,0.1);

}

/* 评论输入框样式 */
.comment-input {
  margin-left: 30rpx;
  margin-top: -20rpx;
  flex: 1;
  height: 60rpx;
  background-color:  #d3d3d3;
  border-radius: 20rpx;
  padding: 0 15rpx;
  font-size: 28rpx;
}

/* 点赞按钮样式 */
.like-button {
  margin-bottom: 55rpx;
  padding-left: 200rpx;
  width: 80rpx;
  height: 80rpx;
  background: none;
  border: none;
}

/* 点赞图标样式 */
.like-icon {
  width: 80rpx;
  height: 80rpx;
}
