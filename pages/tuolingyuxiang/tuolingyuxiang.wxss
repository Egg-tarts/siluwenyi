page {
  background: #ead8bf;
}

.page {
  min-height: 100vh;
  height: 100vh;
  padding: 76rpx 28rpx 52rpx;
  box-sizing: border-box;
  color: #3f2b20;
  background:
    radial-gradient(circle at 86% 8%, rgba(178, 91, 48, 0.2), transparent 30%),
    radial-gradient(circle at 8% 34%, rgba(82, 132, 118, 0.16), transparent 28%),
    linear-gradient(180deg, #fff1df 0%, #ead1b3 62%, #ddba91 100%);
}

.back-button {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  padding: 0 22rpx;
  margin-bottom: 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 250, 239, 0.84);
  color: #7a4f2c;
  font-size: 25rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 18rpx rgba(92, 51, 24, 0.1);
}

.hero {
  position: relative;
  min-height: 364rpx;
  padding: 38rpx 34rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(80, 42, 26, 0.94), rgba(150, 85, 43, 0.78)),
    url("https://free.picui.cn/free/2026/06/21/6a376644b3b26.png");
  background-size: cover;
  background-position: center;
  box-shadow: 0 20rpx 44rpx rgba(96, 54, 25, 0.22);
}

.eyebrow {
  color: rgba(255, 221, 176, 0.82);
  font-size: 22rpx;
  font-weight: 800;
}

.title {
  margin-top: 12rpx;
  color: #fff3df;
  font-size: 64rpx;
  line-height: 1.04;
  font-weight: 900;
}

.subtitle {
  width: 90%;
  margin-top: 18rpx;
  color: rgba(255, 244, 224, 0.8);
  font-size: 27rpx;
  line-height: 1.55;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 28rpx;
}

.hero-tags text {
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 16rpx;
  border: 2rpx solid rgba(255, 230, 190, 0.24);
  border-radius: 999rpx;
  color: #ffe4bb;
  font-size: 22rpx;
  font-weight: 800;
  background: rgba(30, 20, 16, 0.24);
}

.search-card {
  display: flex;
  align-items: center;
  height: 82rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 251, 242, 0.9);
  box-shadow: 0 10rpx 24rpx rgba(96, 54, 25, 0.1);
}

.search-card input {
  flex: 1;
  margin-left: 14rpx;
  color: #3f2b20;
  font-size: 26rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
}

.section-title {
  color: #3f2b20;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}

.section-subtitle {
  margin-top: 8rpx;
  color: rgba(63, 43, 32, 0.58);
  font-size: 24rpx;
}

.collection-strip {
  margin: 20rpx -28rpx 0;
  white-space: nowrap;
}

.collection-track {
  display: inline-flex;
  padding: 0 28rpx;
}

.collection-card {
  width: 300rpx;
  min-height: 210rpx;
  margin-right: 18rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #6d4429, #a96938);
  color: #fff0d6;
  box-shadow: 0 12rpx 26rpx rgba(96, 54, 25, 0.14);
}

.collection-count {
  color: rgba(255, 240, 214, 0.68);
  font-size: 22rpx;
}

.collection-name {
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.collection-desc {
  margin-top: 12rpx;
  color: rgba(255, 244, 224, 0.78);
  font-size: 24rpx;
  line-height: 1.4;
  white-space: normal;
}

.products {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 20rpx;
}

.market-state {
  margin-top: 20rpx;
  padding: 56rpx 28rpx;
  border-radius: 8rpx;
  background: rgba(255, 251, 242, 0.9);
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(96, 54, 25, 0.1);
}

.market-state--error {
  background: rgba(255, 244, 238, 0.92);
}

.state-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #7a4f2c;
  color: #fff0d6;
  font-size: 27rpx;
  font-weight: 900;
}

.state-title {
  margin-top: 20rpx;
  color: #3f2b20;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 900;
}

.product {
  overflow: hidden;
  border-radius: 8rpx;
  background: rgba(255, 251, 242, 0.9);
  box-shadow: 0 10rpx 24rpx rgba(96, 54, 25, 0.1);
}

.product-image {
  width: 100%;
  height: 230rpx;
  background: #ead8bf;
}

.product-image--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(63, 43, 32, 0.48);
  font-size: 24rpx;
  font-weight: 800;
}

.product-info {
  padding: 18rpx;
}

.product-meta {
  color: #b06934;
  font-size: 21rpx;
  font-weight: 800;
}

.product-name {
  margin-top: 8rpx;
  color: #3f2b20;
  font-size: 28rpx;
  line-height: 1.32;
  font-weight: 900;
  min-height: 74rpx;
}

.product-desc {
  margin-top: 8rpx;
  color: rgba(63, 43, 32, 0.62);
  font-size: 22rpx;
  line-height: 1.38;
  min-height: 92rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.product-price {
  color: #b45f2f;
  font-size: 29rpx;
  font-weight: 900;
}

.buy-link {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #3f2b20;
  color: #fff0d6;
  font-size: 21rpx;
  font-weight: 800;
}

.module {
  margin-top: 26rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: rgba(255, 251, 242, 0.88);
  box-shadow: 0 12rpx 28rpx rgba(96, 54, 25, 0.08);
}

.workshop-list {
  margin-top: 18rpx;
}

.workshop-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(176, 105, 52, 0.1);
}

.workshop-item:last-child {
  border-bottom: 0;
}

.workshop-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 54rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #7a4f2c;
  color: #fff0d6;
  font-size: 23rpx;
  font-weight: 900;
}

.workshop-title {
  color: #3f2b20;
  font-size: 29rpx;
  font-weight: 900;
}

.workshop-desc {
  margin-top: 8rpx;
  color: rgba(63, 43, 32, 0.64);
  font-size: 24rpx;
  line-height: 1.45;
}
