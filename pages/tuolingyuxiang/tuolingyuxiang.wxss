/* pages/index/index.wxss */
.container {
  padding: 10px;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 24px;
  font-weight: bold;
}



.products {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 20px;
}

.product {
  width: 48%;
  margin-bottom: 20px;
  text-align: center;
}

.product-image {
  width: 350rpx;
  height: 300rpx;
}

.product-name {
  font-size: 16px;
  margin-top: 5px;
  color: burlywood;
  
}
.aaa{
  display: flex;
  flex-direction: column;
}
.product-price {
  color: burlywood;
  margin-top: 5px;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 10rpx;
  background-color: rgb(229,215,180);
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  width:180%;
  margin-left: 7rpx;
  height: 40rpx;
  margin-top: 40rpx;
  border-radius: 40px;
}