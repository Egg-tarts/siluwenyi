<view class="cart-container">
  <view class="cart-title">我的购物车</view>
  <view wx:if="{{!hasItems}}" class="empty-cart">
    <view class="empty-mark">空</view>
    <view class="empty-text">还没有加入文创商品</view>
  </view>
  <block wx:for="{{cartItems}}" wx:key="id">
    <view class="cart-item" data-id="{{item.cultural_product.id}}" data-index="{{index}}">
      <checkbox
        class="item-check"
        checked="{{item.selected}}"
        bindchange="toggleSelectItem"
      ></checkbox>
      <view class="item-content">
        <view class="item-photo">
          <image src="{{item.cultural_product.images1}}" mode="aspectFill"></image>
        </view>
        <view class="item-info">
          <text class="item-name">{{item.cultural_product.name}}</text>
          <text class="item-quantity">数量 x{{item.quantity}}</text>
        </view>
        <view class="item-price">¥{{item.cultural_product.money}}</view>
      </view>
    </view>
  </block>
</view>
<view class="footer">
  <button class="select-all-btn" bindtap="toggleSelectAll">选择全部</button>
  <view class="cart-total">{{totalText}}</view>
  <button class="pay-btn" bindtap="payNow">付款</button>
</view>
