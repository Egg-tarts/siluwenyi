<view class="cart-container">
  <block wx:for="{{cartItems}}" wx:key="id">
    <view class="cart-item" data-index="{{index}}" bindtouchstart="touchStart" bindtouchmove="touchMove">
      <view class="item-content" style="transform: translateX({{item.translateX}}px)">
        <view class="item-photo">
          <image src="{{item.photo}}" mode="aspectFill"></image>
        </view>
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-quantity">数量：{{item.quantity}}</text>
        </view>
        <view class="item-price">¥{{item.price}}</view>
        <view class="item-select">
          <checkbox value="{{index}}" checked="{{item.checked}}" bindchange="selectItem"></checkbox>
        </view>
      </view>
      <view class="swipe-buttons">
        <button class="share-btn" bindtap="shareItem" data-index="{{index}}">分享</button>
        <button class="delete-btn" bindtap="deleteItem" data-index="{{index}}">删除</button>
      </view>
    </view>
  </block>
</view>

<view class="footer">
  <button class="select-all-btn" bindtap="selectAll">全选</button>
  <button class="pay-btn" bindtap="payNow">一起付款</button>
</view>
