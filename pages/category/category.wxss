.cart-container {
  padding: 26rpx;
  background-color: #f4f4ec;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 150rpx;
}

.cart-title {
  margin: 18rpx 0 28rpx;
  color: #33271c;
  font-size: 42rpx;
  font-weight: 800;
}

.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 480rpx;
  color: rgba(85, 66, 46, 0.62);
}

.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  color: #fff8e7;
  font-size: 34rpx;
  font-weight: 800;
  background: #8a5b34;
}

.empty-text {
  margin-top: 22rpx;
  font-size: 28rpx;
}

.cart-item {
  position: relative;
  margin-bottom: 18rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background-color: rgba(255, 255, 255, 0.78);
  overflow: hidden;
  display: flex;
  align-items: center;
  transition: transform 0.3s ease;
  box-shadow: 0 8rpx 24rpx rgba(83, 62, 37, 0.08);
}

.item-check {
  margin-right: 12rpx;
}

.item-content {
  display: flex;
  align-items: center;
  width: 100%;
  transition: transform 0.3s ease;
}

.item-photo image {
  width: 142rpx;
  height: 142rpx;
  object-fit: cover;
  margin-right: 18rpx;
  border-radius: 8rpx;
}

.item-info {
  flex-grow: 1;
}

.item-name {
  display: block;
  color: #34281d;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.item-quantity {
  display: block;
  font-size: 23rpx;
  color: #8a745a;
}

.item-price {
  font-size: 30rpx;
  color: #a65c22;
  font-weight: 800;
  margin-right: 10rpx;
}

.item-select checkbox {
  width: 20px;
  height: 20px;
}

.swipe-buttons {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  width: 150px;
  transform: translateX(150px);
  transition: transform 0.3s ease;
}

.share-btn, .delete-btn {
  width: 75px;
  height: 100%;
  color: rgb(247, 27, 27);
  font-size: 14px;
}

.share-btn {
  background-color: blue;
}

.delete-btn {
  background-color: red;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: space-between;
  padding: 10px;
  background-color: #fff;
  border-top: 1px solid #f0f0f0;
  box-sizing: border-box;
}

.select-all-btn, .pay-btn {
  padding: 10px 20px;
  cursor: pointer;
}

.select-all-btn {
  background-color: #f1dfbd;
  color: #5a3c21;
}

.cart-total {
  color: #a65c22;
  font-size: 32rpx;
  font-weight: 800;
}

.pay-btn {
  background-color: #2f2419;
  color: white;
}

