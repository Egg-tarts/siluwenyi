/* pages/detail/detail.wxss */
.container {
  padding: 20px;
}
.product-image {
  width: 100%;
  height:450rpx;
  box-shadow:0px 4px 6px 2px #5e5e5e;
}
.product-info {
  margin-top: 20px;
  font-size: larger;
}
.product-name, .product-price, .product-description {
  display: block;
  margin-bottom: 10px;
}
.product-name{
  font-size: 90rpx;
  position: relative; 
  color: rgb(252, 208, 143);

}
.add-to-cart {
  margin-top: 20px;
  background-color: #f0c654;
  color: white;
  border-radius: 5px;
  padding: 10px;
  text-align: center;
  font-size: 18px;
}