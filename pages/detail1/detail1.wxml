<view class="container">
  <image class="product-image" src="{{product.image}}" mode="aspectFill" />
  <view class="product-info">
    <text class="product-name">{{product.name}}</text>
    <text class="product-meta">{{product.city}} · {{product.tag}}</text>
    <text class="product-price">¥{{product.money}}起</text>
    <text class="product-description">{{product.text}}</text>
    <text class="product-description">{{product.details}}</text>
  </view>
  <view class="action-row">
    <button class="add-to-cart" bindtap="addToCart">加入购物车</button>
    <button class="cart-button" bindtap="goCart">去购物车</button>
  </view>

</view>
